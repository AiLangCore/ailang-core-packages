Program {
  Import(package="aivectra" path="src/AiVectra/src/lib.aos")
  Import(package="std-ui-input" path="src/ui/input.aos")
  Import(path="element.aos")

  Export(name=button)
  Export(name=buttonHit)
  Export(name=buttonElement)
  Export(name=buttonRender)
  Export(name=buttonHitElement)

  Let(name=buttonElement) {
    Fn(params=id,x,y,w,h,label,state) {
      Block {
        Return {
          Call(target=uiElement) {
            Var(name=id)
            Lit(value="button")
            Var(name=x)
            Var(name=y)
            Var(name=w)
            Var(name=h)
            Map {
              Field(key="label") { Var(name=label) }
            }
            Var(name=state)
          }
        }
      }
    }
  }

  Let(name=button) {
    Fn(params=handle,x,y,w,h,label,state) {
      Block {
        Call(target=interactiveVectorState) {
          Var(name=handle)
          Var(name=x)
          Var(name=y)
          Var(name=w)
          Var(name=h)
          Var(name=state)
          Lit(value="rect")
          Lit(value="")
          Lit(value="#2563eb")
          Lit(value="#1d4ed8")
          Lit(value="#3b82f6")
          Lit(value="#1e40af")
          Lit(value="#64748b")
        }
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Add { Var(name=x) Lit(value=24) }
          Add { Var(name=y) Lit(value=28) }
          Var(name=label)
          Lit(value="#ffffff")
          Lit(value=18)
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=buttonHit) {
    Fn(params=event,x,y,w,h) {
      Block {
        If {
          Call(target=inputEventIsClickLike) { Var(name=event) }
          Block {
            Return {
              Call(target=pointInRect) {
                Call(target=inputEventX) { Var(name=event) }
                Call(target=inputEventY) { Var(name=event) }
                Var(name=x)
                Var(name=y)
                Var(name=w)
                Var(name=h)
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=buttonRender) {
    Fn(params=handle,element) {
      Block {
        Return {
          Call(target=button) {
            Var(name=handle)
            Call(target=elementX) { Var(name=element) }
            Call(target=elementY) { Var(name=element) }
            Call(target=elementW) { Var(name=element) }
            Call(target=elementH) { Var(name=element) }
            Call(target=elementPropString) { Var(name=element) Lit(value="label") Lit(value="") }
            Call(target=elementState) { Var(name=element) }
          }
        }
      }
    }
  }

  Let(name=buttonHitElement) {
    Fn(params=event,element) {
      Block { Return { Call(target=elementHit) { Var(name=event) Var(name=element) } } }
    }
  }
}
