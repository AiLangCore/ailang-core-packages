Program {
  Import(package="aivectra" path="src/AiVectra/src/lib.aos")
  Import(package="std-ui-input" path="src/ui/input.aos")
  Import(path="element.aos")

  Export(name=field)
  Export(name=entry)
  Export(name=entryHit)
  Export(name=entryNextText)
  Export(name=entryNextCursor)
  Export(name=entryShouldSubmit)
  Export(name=fieldElement)
  Export(name=fieldRender)
  Export(name=entryElement)
  Export(name=entryElementWithCaret)
  Export(name=entryRender)
  Export(name=entryHitElement)

  Let(name=fieldElement) {
    Fn(params=id,x,y,w,label,value,state) {
      Block {
        Return {
          Call(target=uiElement) {
            Var(name=id)
            Lit(value="field")
            Var(name=x)
            Var(name=y)
            Var(name=w)
            Lit(value=48)
            Map {
              Field(key="label") { Var(name=label) }
              Field(key="value") { Var(name=value) }
            }
            Var(name=state)
          }
        }
      }
    }
  }

  Let(name=entryElement) {
    Fn(params=id,x,y,w,h,label,value,placeholder,focused,state) {
      Block {
        Return {
          Call(target=uiElement) {
            Var(name=id)
            Lit(value="entry")
            Var(name=x)
            Var(name=y)
            Var(name=w)
            Var(name=h)
            Map {
              Field(key="label") { Var(name=label) }
              Field(key="value") { Var(name=value) }
              Field(key="placeholder") { Var(name=placeholder) }
              Field(key="focused") { Var(name=focused) }
            }
            Var(name=state)
          }
        }
      }
    }
  }

  Let(name=entryElementWithCaret) {
    Fn(params=id,x,y,w,h,label,value,placeholder,focused,state,cursor,caretVisible) {
      Block {
        Return {
          Call(target=uiElement) {
            Var(name=id)
            Lit(value="entry")
            Var(name=x)
            Var(name=y)
            Var(name=w)
            Var(name=h)
            Map {
              Field(key="label") { Var(name=label) }
              Field(key="value") { Var(name=value) }
              Field(key="placeholder") { Var(name=placeholder) }
              Field(key="focused") { Var(name=focused) }
              Field(key="cursor") { Var(name=cursor) }
              Field(key="caretVisible") { Var(name=caretVisible) }
            }
            Var(name=state)
          }
        }
      }
    }
  }

  Let(name=field) {
    Fn(params=handle,x,y,w,label,value) {
      Block {
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Var(name=x)
          Var(name=y)
          Var(name=label)
          Lit(value="#cbd5e1")
          Lit(value=14)
        }
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Var(name=x)
          Add { Var(name=y) Lit(value=24) }
          Var(name=value)
          Lit(value="#ffffff")
          Lit(value=18)
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=entry) {
    Fn(params=handle,x,y,w,h,label,value,placeholder,focused) {
      Block {
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Var(name=x)
          Var(name=y)
          Var(name=label)
          Lit(value="#cbd5e1")
          Lit(value=14)
        }
        Call(target=interactiveVectorState) {
          Var(name=handle)
          Var(name=x)
          Add { Var(name=y) Lit(value=18) }
          Var(name=w)
          Var(name=h)
          If { Var(name=focused) Block { Lit(value="focused") } Block { Lit(value="normal") } }
          Lit(value="rect")
          Lit(value="")
          Lit(value="#0f172a")
          Lit(value="#0f172a")
          Lit(value="#1e293b")
          Lit(value="#172554")
          Lit(value="#334155")
        }
        Let(name=visibleValue) {
          If {
            Eq { Var(name=value) Lit(value="") }
            Block { Var(name=placeholder) }
            Block { Var(name=value) }
          }
        }
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Add { Var(name=x) Lit(value=16) }
          Add { Var(name=y) Lit(value=30) }
          Var(name=visibleValue)
          If { Eq { Var(name=value) Lit(value="") } Block { Lit(value="#94a3b8") } Block { Lit(value="#ffffff") } }
          Lit(value=18)
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=entryHit) {
    Fn(params=event,x,y,w,h) {
      Block {
        If {
          Call(target=inputEventIsClickLike) { Var(name=event) }
          Block {
            Return {
              Call(target=pointInRect) {
                Call(target=inputEventX) { Var(name=event) }
                Call(target=inputEventY) { Var(name=event) }
                Var(name=x)
                Add { Var(name=y) Lit(value=18) }
                Var(name=w)
                Var(name=h)
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=entryNextText) {
    Fn(params=text,cursor,event,allowEnter,allowTab) {
      Block {
        Return {
          Call(target=editNextText) {
            Var(name=text)
            Var(name=cursor)
            Call(target=inputEventKey) { Var(name=event) }
            Call(target=inputEventText) { Var(name=event) }
            Var(name=allowEnter)
            Var(name=allowTab)
          }
        }
      }
    }
  }

  Let(name=entryNextCursor) {
    Fn(params=text,cursor,event,allowEnter,allowTab) {
      Block {
        Return {
          Call(target=editNextCursor) {
            Var(name=text)
            Var(name=cursor)
            Call(target=inputEventKey) { Var(name=event) }
            Call(target=inputEventText) { Var(name=event) }
            Var(name=allowEnter)
            Var(name=allowTab)
          }
        }
      }
    }
  }

  Let(name=entryShouldSubmit) {
    Fn(params=event,allowEnter) {
      Block {
        Return {
          Call(target=editShouldSubmit) {
            Call(target=inputEventKey) { Var(name=event) }
            Var(name=allowEnter)
          }
        }
      }
    }
  }

  Let(name=fieldRender) {
    Fn(params=handle,element) {
      Block {
        Return {
          Call(target=field) {
            Var(name=handle)
            Call(target=elementX) { Var(name=element) }
            Call(target=elementY) { Var(name=element) }
            Call(target=elementW) { Var(name=element) }
            Call(target=elementPropString) { Var(name=element) Lit(value="label") Lit(value="") }
            Call(target=elementPropString) { Var(name=element) Lit(value="value") Lit(value="") }
          }
        }
      }
    }
  }

  Let(name=entryRender) {
    Fn(params=handle,element) {
      Block {
        Let(name=value) { Call(target=elementPropString) { Var(name=element) Lit(value="value") Lit(value="") } }
        Call(target=entry) {
          Var(name=handle)
          Call(target=elementX) { Var(name=element) }
          Call(target=elementY) { Var(name=element) }
          Call(target=elementW) { Var(name=element) }
          Call(target=elementH) { Var(name=element) }
          Call(target=elementPropString) { Var(name=element) Lit(value="label") Lit(value="") }
          Var(name=value)
          Call(target=elementPropString) { Var(name=element) Lit(value="placeholder") Lit(value="") }
          Call(target=elementPropBool) { Var(name=element) Lit(value="focused") Lit(value=false) }
        }
        If {
          Call(target=elementPropBool) { Var(name=element) Lit(value="caretVisible") Lit(value=false) }
          Block {
            Call(target=sys.ui.drawRect) {
              Var(name=handle)
              Add {
                Add { Call(target=elementX) { Var(name=element) } Lit(value=16) }
                Call(target=caretPixelOffset) {
                  Var(name=value)
                  Call(target=elementPropInt) {
                    Var(name=element)
                    Lit(value="cursor")
                    Call(target=textLen) { Var(name=value) }
                  }
                  Lit(value=9)
                }
              }
              Add { Call(target=elementY) { Var(name=element) } Lit(value=30) }
              Lit(value=2)
              Lit(value=20)
              Lit(value="#e2e8f0")
            }
            Return { Lit(value=0) }
          }
          Block { Return { Lit(value=0) } }
        }
      }
    }
  }

  Let(name=entryHitElement) {
    Fn(params=event,element) {
      Block {
        Return {
          Call(target=entryHit) {
            Var(name=event)
            Call(target=elementX) { Var(name=element) }
            Call(target=elementY) { Var(name=element) }
            Call(target=elementW) { Var(name=element) }
            Call(target=elementH) { Var(name=element) }
          }
        }
      }
    }
  }
}
