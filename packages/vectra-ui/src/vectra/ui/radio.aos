Program {
  Import(package="aivectra" path="src/AiVectra/src/geometry.aos")
  Import(package="std-ui-input" path="src/ui/input.aos")
  Import(path="element.aos")

  Export(name=radioButton)
  Export(name=radioHit)
  Export(name=radioElement)
  Export(name=radioRender)
  Export(name=radioHitElement)

  Let(name=radioElement) {
    Fn(params=id,x,y,label,labelWidth,selected,state) {
      Block {
        Return {
          Call(target=uiElement) {
            Var(name=id)
            Lit(value="radio")
            Var(name=x)
            Var(name=y)
            Add { Var(name=labelWidth) Lit(value=32) }
            Lit(value=24)
            Map {
              Field(key="label") { Var(name=label) }
              Field(key="labelWidth") { Var(name=labelWidth) }
              Field(key="selected") { Var(name=selected) }
            }
            Var(name=state)
          }
        }
      }
    }
  }

  Let(name=radioButton) {
    Fn(params=handle,x,y,label,selected,state) {
      Block {
        Call(target=sys.ui.drawEllipse) { Var(name=handle) Var(name=x) Var(name=y) Lit(value=20) Lit(value=20) Lit(value="#64748b") }
        Call(target=sys.ui.drawEllipse) { Var(name=handle) Add { Var(name=x) Lit(value=2) } Add { Var(name=y) Lit(value=2) } Lit(value=16) Lit(value=16) Lit(value="#111827") }
        If {
          Var(name=selected)
          Block {
            Call(target=sys.ui.drawEllipse) {
              Var(name=handle)
              Add { Var(name=x) Lit(value=6) }
              Add { Var(name=y) Lit(value=6) }
              Lit(value=8) Lit(value=8)
              Lit(value="#60a5fa")
            }
            Lit(value=0)
          }
          Block { Lit(value=0) }
        }
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Add { Var(name=x) Lit(value=30) }
          Add { Var(name=y) Lit(value=2) }
          Var(name=label)
          Lit(value="#e2e8f0")
          Lit(value=16)
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=radioHit) {
    Fn(params=event,x,y,labelWidth) {
      Block {
        If {
          Call(target=inputEventIsClickLike) { Var(name=event) }
          Block {
            Return {
              Call(target=pointInRect) {
                Call(target=inputEventX) { Var(name=event) }
                Call(target=inputEventY) { Var(name=event) }
                Var(name=x)
                Var(name=y)
                Add { Var(name=labelWidth) Lit(value=32) }
                Lit(value=24)
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=radioRender) {
    Fn(params=handle,element) {
      Block {
        Return {
          Call(target=radioButton) {
            Var(name=handle)
            Call(target=elementX) { Var(name=element) }
            Call(target=elementY) { Var(name=element) }
            Call(target=elementPropString) { Var(name=element) Lit(value="label") Lit(value="") }
            Call(target=elementPropBool) { Var(name=element) Lit(value="selected") Lit(value=false) }
            Call(target=elementState) { Var(name=element) }
          }
        }
      }
    }
  }

  Let(name=radioHitElement) {
    Fn(params=event,element) {
      Block { Return { Call(target=elementHit) { Var(name=event) Var(name=element) } } }
    }
  }
}
