Program {
  Import(package="aivectra" path="src/AiVectra/src/lib.aos")
  Import(package="std-ui-input" path="src/ui/input.aos")

  Export(name=radioButton)
  Export(name=radioHit)

  Let(name=radioButton) {
    Fn(params=handle,x,y,label,selected,state) {
      Block {
        Call(target=interactiveVectorState) {
          Var(name=handle)
          Var(name=x)
          Var(name=y)
          Lit(value=18)
          Lit(value=18)
          Var(name=state)
          Lit(value="ellipse")
          Lit(value="")
          Lit(value="#0f172a")
          Lit(value="#1d4ed8")
          Lit(value="#1e293b")
          Lit(value="#172554")
          Lit(value="#334155")
        }
        If {
          Var(name=selected)
          Block {
            Call(target=sys.ui.drawEllipse) {
              Var(name=handle)
              Add { Var(name=x) Lit(value=5) }
              Add { Var(name=y) Lit(value=5) }
              Lit(value=8)
              Lit(value=8)
              Lit(value="#60a5fa")
            }
            Lit(value=0)
          }
          Block { Lit(value=0) }
        }
        Call(target=sys.ui.drawText) {
          Var(name=handle)
          Add { Var(name=x) Lit(value=28) }
          Add { Var(name=y) Lit(value=2) }
          Var(name=label)
          Lit(value="#e2e8f0")
          Lit(value=16)
        }
        Return { Lit(value=0) }
      }
    }
  }

  Let(name=radioHit) {
    Fn(params=event,x,y,labelWidth) {
      Block {
        If {
          Call(target=inputEventIsClickLike) { Var(name=event) }
          Block {
            Return {
              Call(target=pointInRect) {
                Call(target=inputEventX) { Var(name=event) }
                Call(target=inputEventY) { Var(name=event) }
                Var(name=x)
                Var(name=y)
                Add { Var(name=labelWidth) Lit(value=32) }
                Lit(value=24)
              }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }
}
