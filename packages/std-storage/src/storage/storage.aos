Program {
  Export(name=localAvailable)
  Export(name=localGet)
  Export(name=localSet)
  Export(name=localDelete)
  Export(name=localExists)
  Export(name=secureAvailable)
  Export(name=secureGet)
  Export(name=secureSet)
  Export(name=secureDelete)
  Export(name=secureExists)

  Let(name=localAvailable) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.storage.local.available) { } }
      }
    }
  }

  Let(name=localGet) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.local.get) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }

  Let(name=localSet) {
    Fn(params=appId,key,value) {
      Block {
        Return {
          Call(target=sys.storage.local.set) {
            Var(name=appId)
            Var(name=key)
            Var(name=value)
          }
        }
      }
    }
  }

  Let(name=localDelete) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.local.delete) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }

  Let(name=localExists) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.local.exists) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }

  Let(name=secureAvailable) {
    Fn(params=_) {
      Block {
        Return { Call(target=sys.storage.secure.available) { } }
      }
    }
  }

  Let(name=secureGet) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.secure.get) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }

  Let(name=secureSet) {
    Fn(params=appId,key,value) {
      Block {
        Return {
          Call(target=sys.storage.secure.set) {
            Var(name=appId)
            Var(name=key)
            Var(name=value)
          }
        }
      }
    }
  }

  Let(name=secureDelete) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.secure.delete) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }

  Let(name=secureExists) {
    Fn(params=appId,key) {
      Block {
        Return {
          Call(target=sys.storage.secure.exists) {
            Var(name=appId)
            Var(name=key)
          }
        }
      }
    }
  }
}
