Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=state) {
    Call(target=http.httpRequestWithTimeoutPolls) {
      Lit(value="GET")
      Lit(value="example.com")
      Lit(value=80)
      Lit(value="/")
      Lit(value="")
      Lit(value="")
      Lit(value=4096)
      Lit(value=17)
    }
  }

  Call(target=io.print) {
    Call(target=http.httpRequestPhase) { Var(name=state) }
  }
  Call(target=io.print) {
    Call(target=http.httpRequestRemaining) { Var(name=state) }
  }
}
