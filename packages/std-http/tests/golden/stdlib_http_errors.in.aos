Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=timeoutState) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="error")
      Lit(value="GET / HTTP/1.1")
      Lit(value=4096)
      Lit(value=0)
      Lit(value=-1)
      Lit(value="")
      Lit(value="")
      Lit(value="timeout")
      Lit(value=0)
    }
  }

  Let(name=connectState) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="error")
      Lit(value="GET / HTTP/1.1")
      Lit(value=4096)
      Lit(value=0)
      Lit(value=-1)
      Lit(value="")
      Lit(value="")
      Lit(value="connect_invalid")
      Lit(value=0)
    }
  }

  Let(name=connectTlsDetailState) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="error")
      Lit(value="GET / HTTP/1.1")
      Lit(value=4096)
      Lit(value=0)
      Lit(value=-1)
      Lit(value="")
      Lit(value="")
      Lit(value="connect_tls_failed:dns_failed:No such host")
      Lit(value=0)
    }
  }

  Let(name=writeState) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="error")
      Lit(value="GET / HTTP/1.1")
      Lit(value=4096)
      Lit(value=0)
      Lit(value=-1)
      Lit(value="")
      Lit(value="")
      Lit(value="write_failed")
      Lit(value=0)
    }
  }

  Let(name=readState) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="error")
      Lit(value="GET / HTTP/1.1")
      Lit(value=4096)
      Lit(value=0)
      Lit(value=-1)
      Lit(value="")
      Lit(value="")
      Lit(value="read_failed")
      Lit(value=0)
    }
  }

  Call(target=io.print) { Call(target=http.httpRequestTimedOut) { Var(name=timeoutState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedConnect) { Var(name=timeoutState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedConnect) { Var(name=connectState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedConnect) { Var(name=connectTlsDetailState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedDns) { Var(name=connectTlsDetailState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedTls) { Var(name=connectTlsDetailState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedWrite) { Var(name=writeState) } }
  Call(target=io.print) { Call(target=http.httpRequestFailedRead) { Var(name=readState) } }
}
