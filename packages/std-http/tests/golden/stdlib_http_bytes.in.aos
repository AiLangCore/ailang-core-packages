Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/bytes.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=state) {
    Call(target=http.httpMakeRequestState) {
      Lit(value="done")
      Lit(value="")
      Lit(value=0)
      Lit(value=0)
      Lit(value=0)
      Lit(value="")
      Lit(value="UE5HISE=")
      Lit(value="")
      Lit(value=0)
    }
  }

  Call(target=io.print) {
    Call(target=bytes.toBase64) {
      Call(target=http.httpRequestResponseBytes) { Var(name=state) }
    }
  }

  Call(target=io.print) {
    Call(target=bytes.toBase64) {
      Call(target=http.httpResponseBodyBytes) {
        Call(target=bytes.fromUtf8String) {
          Lit(value="HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nWIKI")
        }
      }
    }
  }
}
