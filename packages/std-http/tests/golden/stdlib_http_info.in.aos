Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/core.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=responseText) {
    Lit(value="HTTP/1.1 302 Found\r\nLocation: https://example.com/next?q=1\r\nContent-Type: text/plain\r\n\r\nMoved")
  }

  Let(name=info) {
    Call(target=http.httpResponseInfo) { Var(name=responseText) }
  }

  Call(target=io.print) {
    Call(target=mapGetIntOr) {
      Var(name=info)
      Lit(value="statusCode")
      Lit(value=-1)
    }
  }
  Call(target=io.print) {
    Call(target=mapGetBoolOr) {
      Var(name=info)
      Lit(value="isRedirect")
      Lit(value=false)
    }
  }
  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=info)
      Lit(value="redirectLocation")
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=info)
      Lit(value="contentType")
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=info)
      Lit(value="redirectHost")
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=mapGetIntOr) {
      Var(name=info)
      Lit(value="redirectPort")
      Lit(value=-1)
    }
  }
  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=info)
      Lit(value="redirectPath")
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=info)
      Lit(value="body")
      Lit(value="missing")
    }
  }
}
