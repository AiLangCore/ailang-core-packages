Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=redirectText) {
    Lit(value="HTTP/1.1 302 Found\r\nLocation: https://example.com/next?q=1\r\nContent-Length: 0\r\n\r\n")
  }

  Let(name=okText) {
    Lit(value="HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
  }

  Call(target=io.print) {
    Call(target=http.httpResponseIsRedirect) { Var(name=redirectText) }
  }
  Call(target=io.print) {
    Call(target=http.httpResponseRedirectLocation) {
      Var(name=redirectText)
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=http.httpResponseIsRedirect) { Var(name=okText) }
  }
  Call(target=io.print) {
    Call(target=http.httpResponseRedirectLocation) {
      Var(name=okText)
      Lit(value="missing")
    }
  }
}
