Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/io.aos")

  Let(name=responseText) {
    Lit(value="HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: text/plain\r\n\r\n4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
  }

  Call(target=io.print) {
    Call(target=http.httpResponseStatusCode) { Var(name=responseText) }
  }
  Call(target=io.print) {
    Call(target=http.httpResponseHeaderGet) {
      Var(name=responseText)
      Lit(value="Content-Type")
      Lit(value="missing")
    }
  }
  Call(target=io.print) {
    Call(target=http.httpResponseBody) { Var(name=responseText) }
  }
}
