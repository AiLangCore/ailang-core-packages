  Let(name=httpRequestPollConnecting) {
    Fn(params=state) {
      Block {
        Let(name=op) { Call(target=httpRequestOp) { Var(name=state) } }
        Let(name=status) { Call(target=sys.net.async.poll) { Var(name=op) } }
        Let(name=remaining) { Call(target=httpRequestRemaining) { Var(name=state) } }
        If {
          Eq { Var(name=status) Lit(value=0) }
          Block {
            If {
              Eq { Var(name=remaining) Lit(value=0) }
              Block {
                Call(target=sys.net.async.cancel) { Var(name=op) }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
