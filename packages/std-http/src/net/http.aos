Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(sdk="ailang" path="std/bytes.aos")
  Import(sdk="ailang" path="std/str.aos")
  Let(name=httpHeaders) {
    Fn(params=req) {
      Block {
        Return { ChildAt { Var(name=req) Lit(value=0) } }
      }
    }
  }

  Let(name=httpQuery) {
    Fn(params=req) {
      Block {
        Return { ChildAt { Var(name=req) Lit(value=1) } }
      }
    }
  }

  Let(name=httpPath) {
    Fn(params=req) {
      Block {
        Return { AttrValueString { Var(name=req) Lit(value=1) } }
      }
    }
  }

  Let(name=httpMapGetString) {
    Fn(params=map,key,fallback) {
      Block {
        Return {
          Call(target=httpMapGetStringAt) {
            Var(name=map)
            Var(name=key)
            Lit(value=0)
            Var(name=fallback)
          }
        }
      }
    }
  }

  Let(name=httpMapGetStringAt) {
    Fn(params=map,key,index,fallback) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=map) } }
          Block { Return { Var(name=fallback) } }
          Block {
            Let(name=field) { ChildAt { Var(name=map) Var(name=index) } }
            Let(name=fieldKey) { AttrValueString { Var(name=field) Lit(value=0) } }
            If {
              Eq { Var(name=fieldKey) Var(name=key) }
              Block {
                If {
                  Eq { ChildCount { Var(name=field) } Lit(value=0) }
                  Block { Return { Var(name=fallback) } }
                  Block {
                    Let(name=lit) { ChildAt { Var(name=field) Lit(value=0) } }
                    Return { AttrValueString { Var(name=lit) Lit(value=0) } }
                  }
                }
              }
              Block {
                Return {
                  Call(target=httpMapGetStringAt) {
                    Var(name=map)
                    Var(name=key)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=fallback)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpHeaderGet) {
    Fn(params=req,key,fallback) {
      Block {
        Return {
          Call(target=httpMapGetString) {
            Call(target=httpHeaders) { Var(name=req) }
            Var(name=key)
            Var(name=fallback)
          }
        }
      }
    }
  }

  Let(name=httpQueryGet) {
    Fn(params=req,key,fallback) {
      Block {
        Return {
          Call(target=httpMapGetString) {
            Call(target=httpQuery) { Var(name=req) }
            Var(name=key)
            Var(name=fallback)
          }
        }
      }
    }
  }

  Let(name=httpResponse) {
    Fn(params=statusCode,reason,contentType,body) {
      Block {
        Let(name=length) { Call(target=utf8ByteCount) { Var(name=body) } }
        Return {
          StrConcat {
            Lit(value="HTTP/1.1 ")
            StrConcat {
              ToString { Var(name=statusCode) }
              StrConcat {
                Lit(value=" ")
                StrConcat {
                  Var(name=reason)
                  StrConcat {
                    Lit(value="\r\nContent-Type: ")
                    StrConcat {
                      Var(name=contentType)
                      StrConcat {
                        Lit(value="\r\nContent-Length: ")
                        StrConcat {
                          ToString { Var(name=length) }
                          StrConcat {
                            Lit(value="\r\n\r\n")
                            Var(name=body)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpErrorJson) {
    Fn(params=code,message) {
      Block {
        Return {
          StrConcat {
            Lit(value="{\"error\":\"")
            StrConcat {
              StrEscape { Var(name=code) }
              StrConcat {
                Lit(value="\",\"message\":\"")
                StrConcat {
                  StrEscape { Var(name=message) }
                  Lit(value="\"}")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpEmitRaw) {
    Fn(params=state,responseText) {
      Block {
        Let(name=cmdNode) {
          AppendAttr {
            AppendAttr {
              MakeNode { Lit(value="Command") Lit(value="std_http_emit_raw") }
              MakeLitString { Lit(value="type") Lit(value="http.raw") }
            }
            MakeLitString { Lit(value="payload") Var(name=responseText) }
          }
        }
        Return {
          AppendChild {
            AppendChild {
              MakeBlock { Lit(value="next") }
              Var(name=state)
            }
            Var(name=cmdNode)
          }
        }
      }
    }
  }

  Let(name=httpMakeRequestState) {
    Fn(params=phase,requestText,maxBytes,op,connection,response,responseBytesBase64,error,remainingPolls) {
      Block {
        Let(name=base) { MakeBlock { Lit(value="http_req_state") } }
        Let(name=withPhase) {
          AppendChild {
            Var(name=base)
            MakeLitString {
              Lit(value="http_state_phase")
              Var(name=phase)
            }
          }
        }
        Let(name=withRequestText) {
          AppendChild {
            Var(name=withPhase)
            MakeLitString {
              Lit(value="http_state_request")
              Var(name=requestText)
            }
          }
        }
        Let(name=withMaxBytes) {
          AppendChild {
            Var(name=withRequestText)
            MakeLitInt {
              Lit(value="http_state_maxBytes")
              Var(name=maxBytes)
            }
          }
        }
        Let(name=withOp) {
          AppendChild {
            Var(name=withMaxBytes)
            MakeLitInt {
              Lit(value="http_state_op")
              Var(name=op)
            }
          }
        }
        Let(name=withConnection) {
          AppendChild {
            Var(name=withOp)
            MakeLitInt {
              Lit(value="http_state_connection")
              Var(name=connection)
            }
          }
        }
        Let(name=withResponse) {
          AppendChild {
            Var(name=withConnection)
            MakeLitString {
              Lit(value="http_state_response")
              Var(name=response)
            }
          }
        }
        Let(name=withResponseBytes) {
          AppendChild {
            Var(name=withResponse)
            MakeLitString {
              Lit(value="http_state_responseBytesBase64")
              Var(name=responseBytesBase64)
            }
          }
        }
        Let(name=withError) {
          AppendChild {
            Var(name=withResponseBytes)
            MakeLitString {
              Lit(value="http_state_error")
              Var(name=error)
            }
          }
        }
        Return {
          AppendChild {
            Var(name=withError)
            MakeLitInt {
              Lit(value="http_state_remainingPolls")
              Var(name=remainingPolls)
            }
          }
        }
      }
    }
  }

  Let(name=httpRequestPhase) {
    Fn(params=state) {
      Block { Return { AttrValueString { ChildAt { Var(name=state) Lit(value=0) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestText) {
    Fn(params=state) {
      Block { Return { AttrValueString { ChildAt { Var(name=state) Lit(value=1) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestMaxBytes) {
    Fn(params=state) {
      Block { Return { AttrValueInt { ChildAt { Var(name=state) Lit(value=2) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestOp) {
    Fn(params=state) {
      Block { Return { AttrValueInt { ChildAt { Var(name=state) Lit(value=3) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestConnection) {
    Fn(params=state) {
      Block { Return { AttrValueInt { ChildAt { Var(name=state) Lit(value=4) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestResponse) {
    Fn(params=state) {
      Block { Return { AttrValueString { ChildAt { Var(name=state) Lit(value=5) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestResponseBytesBase64) {
    Fn(params=state) {
      Block { Return { AttrValueString { ChildAt { Var(name=state) Lit(value=6) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestResponseBytes) {
    Fn(params=state) {
      Block {
        Let(name=encoded) { Call(target=httpRequestResponseBytesBase64) { Var(name=state) } }
        If {
          Eq { Var(name=encoded) Lit(value="") }
          Block { Return { Call(target=bytes.fromUtf8String) { Lit(value="") } } }
          Block { Return { Call(target=bytes.fromBase64) { Var(name=encoded) } } }
        }
      }
    }
  }

  Let(name=httpRequestError) {
    Fn(params=state) {
      Block { Return { AttrValueString { ChildAt { Var(name=state) Lit(value=7) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestTimedOut) {
    Fn(params=state) {
      Block {
        Return {
          Eq {
            Call(target=httpRequestError) { Var(name=state) }
            Lit(value="timeout")
          }
        }
      }
    }
  }

  Let(name=httpErrorStartsWith) {
    Fn(params=error,prefix) {
      Block {
        Return {
          Eq {
            Call(target=find) {
              Var(name=error)
              Var(name=prefix)
              Lit(value=0)
            }
            Lit(value=0)
          }
        }
      }
    }
  }

  Let(name=httpRequestFailedConnect) {
    Fn(params=state) {
      Block {
        Let(name=error) { Call(target=httpRequestError) { Var(name=state) } }
        If { Eq { Var(name=error) Lit(value="connect_failed") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        If { Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="connect_failed:") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        If { Eq { Var(name=error) Lit(value="connect_invalid") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        If { Eq { Var(name=error) Lit(value="connect_tls_failed") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        Return { Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="connect_tls_failed:") } }
      }
    }
  }

  Let(name=httpRequestFailedWrite) {
    Fn(params=state) {
      Block {
        Return {
          Eq {
            Call(target=httpRequestError) { Var(name=state) }
            Lit(value="write_failed")
          }
        }
      }
    }
  }

  Let(name=httpRequestFailedRead) {
    Fn(params=state) {
      Block {
        Return {
          Eq {
            Call(target=httpRequestError) { Var(name=state) }
            Lit(value="read_failed")
          }
        }
      }
    }
  }

  Let(name=httpRequestFailedDns) {
    Fn(params=state) {
      Block {
        Let(name=error) { Call(target=httpRequestError) { Var(name=state) } }
        If { Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="dns_failed:") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        If { Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="connect_failed:dns_failed:") } Block { Return { Lit(value=true) } } Block { Lit(value=0) } }
        Return { Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="connect_tls_failed:dns_failed:") } }
      }
    }
  }

  Let(name=httpRequestFailedTls) {
    Fn(params=state) {
      Block {
        Let(name=error) { Call(target=httpRequestError) { Var(name=state) } }
        Return {
          Call(target=httpErrorStartsWith) { Var(name=error) Lit(value="connect_tls_failed:") }
        }
      }
    }
  }

  Let(name=httpRequestRemaining) {
    Fn(params=state) {
      Block { Return { AttrValueInt { ChildAt { Var(name=state) Lit(value=8) } Lit(value=0) } } }
    }
  }

  Let(name=httpRequestDone) {
    Fn(params=state) {
      Block { Return { Eq { Call(target=httpRequestPhase) { Var(name=state) } Lit(value="done") } } }
    }
  }

  Let(name=httpRequestFailed) {
    Fn(params=state) {
      Block { Return { Eq { Call(target=httpRequestPhase) { Var(name=state) } Lit(value="error") } } }
    }
  }

  Let(name=httpFindCrlfCrlf) {
    Fn(params=text,start) {
      Block {
        Return {
          Call(target=find) {
            Var(name=text)
            Lit(value="\r\n\r\n")
            Var(name=start)
          }
        }
      }
    }
  }

  Let(name=httpBytesHasCrlfCrlfAt) {
    Fn(params=data,index) {
      Block {
        If {
          Eq { Var(name=index) Call(target=length) { Var(name=data) } }
          Block { Return { Lit(value=false) } }
          Block {
            If {
              Eq { Var(name=index) Add { Call(target=length) { Var(name=data) } Lit(value=-1) } }
              Block { Return { Lit(value=false) } }
              Block {
                If {
                  Eq { Var(name=index) Add { Call(target=length) { Var(name=data) } Lit(value=-2) } }
                  Block { Return { Lit(value=false) } }
                  Block {
                    If {
                      Eq { Var(name=index) Add { Call(target=length) { Var(name=data) } Lit(value=-3) } }
                      Block { Return { Lit(value=false) } }
                      Block {
                        If {
                          Eq { Call(target=bytes.at) { Var(name=data) Var(name=index) } Lit(value=13) }
                          Block {
                            If {
                              Eq { Call(target=bytes.at) { Var(name=data) Add { Var(name=index) Lit(value=1) } } Lit(value=10) }
                              Block {
                                If {
                                  Eq { Call(target=bytes.at) { Var(name=data) Add { Var(name=index) Lit(value=2) } } Lit(value=13) }
                                  Block {
                                    Return {
                                      Eq { Call(target=bytes.at) { Var(name=data) Add { Var(name=index) Lit(value=3) } } Lit(value=10) }
                                    }
                                  }
                                  Block { Return { Lit(value=false) } }
                                }
                              }
                              Block { Return { Lit(value=false) } }
                            }
                          }
                          Block { Return { Lit(value=false) } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpFindBytesCrlfCrlfAt) {
    Fn(params=data,index) {
      Block {
        If {
          Call(target=httpBytesHasCrlfCrlfAt) {
            Var(name=data)
            Var(name=index)
          }
          Block { Return { Var(name=index) } }
          Block {
            If {
              Eq { Var(name=index) Call(target=length) { Var(name=data) } }
              Block { Return { Lit(value=-1) } }
              Block {
                Return {
                  Call(target=httpFindBytesCrlfCrlfAt) {
                    Var(name=data)
                    Add { Var(name=index) Lit(value=1) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpResponseBodyBytes) {
    Fn(params=responseBytes) {
      Block {
        Let(name=marker) {
          Call(target=httpFindBytesCrlfCrlfAt) {
            Var(name=responseBytes)
            Lit(value=0)
          }
        }
        If {
          Eq { Var(name=marker) Lit(value=-1) }
          Block { Return { Call(target=bytes.slice) { Var(name=responseBytes) Lit(value=0) Lit(value=0) } } }
          Block {
            Let(name=bodyStart) {
              Add { Var(name=marker) Lit(value=4) }
            }
            Return {
              Call(target=bytes.slice) {
                Var(name=responseBytes)
                Var(name=bodyStart)
                Lit(value=2147483647)
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpFindCrlf) {
    Fn(params=text,start) {
      Block {
        Return {
          Call(target=find) {
            Var(name=text)
            Lit(value="\r\n")
            Var(name=start)
          }
        }
      }
    }
  }

  Let(name=httpMul16) {
    Fn(params=value) {
      Block {
        Return {
          Add {
            Var(name=value)
            Add {
              Var(name=value)
              Add {
                Var(name=value)
                Add {
                  Var(name=value)
                  Add {
                    Var(name=value)
                    Add {
                      Var(name=value)
                      Add {
                        Var(name=value)
                        Add {
                          Var(name=value)
                          Add {
                            Var(name=value)
                            Add {
                              Var(name=value)
                              Add {
                                Var(name=value)
                                Add {
                                  Var(name=value)
                                  Add {
                                    Var(name=value)
                                    Add {
                                      Var(name=value)
                                      Add {
                                        Var(name=value)
                                        Var(name=value)
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpHexDigitValue) {
    Fn(params=ch) {
      Block {
        If {
          Eq { Var(name=ch) Lit(value="0") }
          Block { Return { Lit(value=0) } }
          Block {
            If {
              Eq { Var(name=ch) Lit(value="1") }
              Block { Return { Lit(value=1) } }
              Block {
                If {
                  Eq { Var(name=ch) Lit(value="2") }
                  Block { Return { Lit(value=2) } }
                  Block {
                    If {
                      Eq { Var(name=ch) Lit(value="3") }
                      Block { Return { Lit(value=3) } }
                      Block {
                        If {
                          Eq { Var(name=ch) Lit(value="4") }
                          Block { Return { Lit(value=4) } }
                          Block {
                            If {
                              Eq { Var(name=ch) Lit(value="5") }
                              Block { Return { Lit(value=5) } }
                              Block {
                                If {
                                  Eq { Var(name=ch) Lit(value="6") }
                                  Block { Return { Lit(value=6) } }
                                  Block {
                                    If {
                                      Eq { Var(name=ch) Lit(value="7") }
                                      Block { Return { Lit(value=7) } }
                                      Block {
                                        If {
                                          Eq { Var(name=ch) Lit(value="8") }
                                          Block { Return { Lit(value=8) } }
                                          Block {
                                            If {
                                              Eq { Var(name=ch) Lit(value="9") }
                                              Block { Return { Lit(value=9) } }
                                              Block {
                                                If {
                                                  Eq { Var(name=ch) Lit(value="A") }
                                                  Block { Return { Lit(value=10) } }
                                                  Block {
                                                    If {
                                                      Eq { Var(name=ch) Lit(value="B") }
                                                      Block { Return { Lit(value=11) } }
                                                      Block {
                                                        If {
                                                          Eq { Var(name=ch) Lit(value="C") }
                                                          Block { Return { Lit(value=12) } }
                                                          Block {
                                                            If {
                                                              Eq { Var(name=ch) Lit(value="D") }
                                                              Block { Return { Lit(value=13) } }
                                                              Block {
                                                                If {
                                                                  Eq { Var(name=ch) Lit(value="E") }
                                                                  Block { Return { Lit(value=14) } }
                                                                  Block {
                                                                    If {
                                                                      Eq { Var(name=ch) Lit(value="F") }
                                                                      Block { Return { Lit(value=15) } }
                                                                      Block {
                                                                        If {
                                                                          Eq { Var(name=ch) Lit(value="a") }
                                                                          Block { Return { Lit(value=10) } }
                                                                          Block {
                                                                            If {
                                                                              Eq { Var(name=ch) Lit(value="b") }
                                                                              Block { Return { Lit(value=11) } }
                                                                              Block {
                                                                                If {
                                                                                  Eq { Var(name=ch) Lit(value="c") }
                                                                                  Block { Return { Lit(value=12) } }
                                                                                  Block {
                                                                                    If {
                                                                                      Eq { Var(name=ch) Lit(value="d") }
                                                                                      Block { Return { Lit(value=13) } }
                                                                                      Block {
                                                                                        If {
                                                                                          Eq { Var(name=ch) Lit(value="e") }
                                                                                          Block { Return { Lit(value=14) } }
                                                                                          Block {
                                                                                            If {
                                                                                              Eq { Var(name=ch) Lit(value="f") }
                                                                                              Block { Return { Lit(value=15) } }
                                                                                              Block { Return { Lit(value=-1) } }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                    }
                                                                  }
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpParseHexStringAt) {
    Fn(params=text,index,acc) {
      Block {
        Let(name=ch) {
          Call(target=substring) {
            Var(name=text)
            Var(name=index)
            Lit(value=1)
          }
        }
        If {
          Eq { Var(name=ch) Lit(value="") }
          Block { Return { Var(name=acc) } }
          Block {
            If {
              Eq { Var(name=ch) Lit(value=";") }
              Block { Return { Var(name=acc) } }
              Block {
                Let(name=digit) { Call(target=httpHexDigitValue) { Var(name=ch) } }
                If {
                  Eq { Var(name=digit) Lit(value=-1) }
                  Block { Return { Var(name=acc) } }
                  Block {
                    Return {
                      Call(target=httpParseHexStringAt) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Add {
                          Call(target=httpMul16) { Var(name=acc) }
                          Var(name=digit)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpDigitValue) {
    Fn(params=ch) {
      Block {
        If {
          Eq { Var(name=ch) Lit(value="0") }
          Block { Return { Lit(value=0) } }
          Block {
            If {
              Eq { Var(name=ch) Lit(value="1") }
              Block { Return { Lit(value=1) } }
              Block {
                If {
                  Eq { Var(name=ch) Lit(value="2") }
                  Block { Return { Lit(value=2) } }
                  Block {
                    If {
                      Eq { Var(name=ch) Lit(value="3") }
                      Block { Return { Lit(value=3) } }
                      Block {
                        If {
                          Eq { Var(name=ch) Lit(value="4") }
                          Block { Return { Lit(value=4) } }
                          Block {
                            If {
                              Eq { Var(name=ch) Lit(value="5") }
                              Block { Return { Lit(value=5) } }
                              Block {
                                If {
                                  Eq { Var(name=ch) Lit(value="6") }
                                  Block { Return { Lit(value=6) } }
                                  Block {
                                    If {
                                      Eq { Var(name=ch) Lit(value="7") }
                                      Block { Return { Lit(value=7) } }
                                      Block {
                                        If {
                                          Eq { Var(name=ch) Lit(value="8") }
                                          Block { Return { Lit(value=8) } }
                                          Block {
                                            If {
                                              Eq { Var(name=ch) Lit(value="9") }
                                              Block { Return { Lit(value=9) } }
                                              Block { Return { Lit(value=-1) } }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
