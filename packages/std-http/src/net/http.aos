                  }
                }
              }
              Block {
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="connecting")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Call(target=httpRequestOp) { Var(name=state) }
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="")
                    Add { Var(name=remaining) Lit(value=-1) }
                  }
                }
              }
            }
          }
          Block {
            If {
              Eq { Var(name=status) Lit(value=1) }
              Block { Lit(value=0) }
              Block {
                Let(name=connectError) { Call(target=sys.net.async.error) { Var(name=op) } }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Var(name=connectError)
                    Lit(value=0)
                  }
                }
              }
            }
            Let(name=connection) { Call(target=sys.net.async.resultInt) { Var(name=op) } }
            If {
              Eq { Var(name=connection) Lit(value=-1) }
              Block {
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="connect_invalid")
                    Lit(value=0)
                  }
                }
              }
              Block {
                Let(name=writeOp) {
                  Call(target=sys.net.tcp.writeStart) {
                    Var(name=connection)
                    Call(target=bytes.fromUtf8String) { Call(target=httpRequestText) { Var(name=state) } }
                  }
                }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="writing")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Var(name=writeOp)
                    Var(name=connection)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="")
                    Call(target=httpRequestRemaining) { Var(name=state) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpRequestPollWriting) {
    Fn(params=state) {
      Block {
        Let(name=op) { Call(target=httpRequestOp) { Var(name=state) } }
        Let(name=connection) { Call(target=httpRequestConnection) { Var(name=state) } }
        Let(name=status) { Call(target=sys.net.async.poll) { Var(name=op) } }
        Let(name=remaining) { Call(target=httpRequestRemaining) { Var(name=state) } }
        If {
          Eq { Var(name=status) Lit(value=0) }
          Block {
            If {
              Eq { Var(name=remaining) Lit(value=0) }
              Block {
                Call(target=sys.net.async.cancel) { Var(name=op) }
                Call(target=sys.net.tcp.close) { Var(name=connection) }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="timeout")
                    Lit(value=0)
                  }
                }
              }
              Block {
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="writing")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Call(target=httpRequestOp) { Var(name=state) }
                    Call(target=httpRequestConnection) { Var(name=state) }
                    Lit(value="")
                    Lit(value="")
                    Lit(value="")
                    Add { Var(name=remaining) Lit(value=-1) }
                  }
                }
              }
            }
          }
          Block {
            If {
              Eq { Var(name=status) Lit(value=1) }
              Block { Lit(value=0) }
              Block {
                Call(target=sys.net.tcp.close) { Var(name=connection) }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="write_failed")
                    Lit(value=0)
                  }
                }
              }
            }
            Let(name=readOp) {
              Call(target=sys.net.tcp.readStart) {
                Var(name=connection)
                Call(target=httpRequestMaxBytes) { Var(name=state) }
              }
            }
            Return {
              Call(target=httpMakeRequestState) {
                Lit(value="reading")
                Call(target=httpRequestText) { Var(name=state) }
                Call(target=httpRequestMaxBytes) { Var(name=state) }
                Var(name=readOp)
                Var(name=connection)
                Lit(value="")
                Lit(value="")
                Lit(value="")
                Call(target=httpRequestRemaining) { Var(name=state) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpRequestPollReading) {
    Fn(params=state) {
      Block {
        Let(name=op) { Call(target=httpRequestOp) { Var(name=state) } }
        Let(name=connection) { Call(target=httpRequestConnection) { Var(name=state) } }
        Let(name=status) { Call(target=sys.net.async.poll) { Var(name=op) } }
        Let(name=remaining) { Call(target=httpRequestRemaining) { Var(name=state) } }
        If {
          Eq { Var(name=status) Lit(value=0) }
          Block {
            If {
              Eq { Var(name=remaining) Lit(value=0) }
              Block {
                Call(target=sys.net.async.cancel) { Var(name=op) }
                Call(target=sys.net.tcp.close) { Var(name=connection) }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="timeout")
                    Lit(value=0)
                  }
