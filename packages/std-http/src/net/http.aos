        Let(name=connectOp) {
          If {
            Eq { Var(name=port) Lit(value=443) }
            Block { Call(target=sys.net.tcp.connectTlsStart) { Var(name=host) Var(name=port) } }
            Block { Call(target=sys.net.tcp.connectStart) { Var(name=host) Var(name=port) } }
