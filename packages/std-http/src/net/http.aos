        Let(name=requestText) {
          StrConcat {
            Var(name=method)
            StrConcat {
              Lit(value=" ")
              StrConcat {
                Var(name=path)
                StrConcat {
                  Lit(value=" HTTP/1.1\r\nHost: ")
                  StrConcat {
                    Var(name=host)
                    StrConcat {
                      Lit(value="\r\n")
                      StrConcat {
                        Var(name=headerText)
                        StrConcat {
                          Var(name=contentLengthHeader)
                          StrConcat {
                            Lit(value="\r\n")
                            Var(name=body)
                          }
                        }
                      }
                    }
                  }
                }
              }
