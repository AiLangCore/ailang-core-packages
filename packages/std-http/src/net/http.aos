  Let(name=httpRequestPoll) {
    Fn(params=state) {
      Block {
        Let(name=phase) { Call(target=httpRequestPhase) { Var(name=state) } }
        If {
          Eq { Var(name=phase) Lit(value="connecting") }
          Block { Return { Call(target=httpRequestPollConnecting) { Var(name=state) } } }
          Block {
            If {
              Eq { Var(name=phase) Lit(value="writing") }
              Block { Return { Call(target=httpRequestPollWriting) { Var(name=state) } } }
              Block {
                If {
                  Eq { Var(name=phase) Lit(value="reading") }
                  Block { Return { Call(target=httpRequestPollReading) { Var(name=state) } } }
                  Block { Return { Var(name=state) } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=httpRequestAwait) {
    Fn(params=state) {
      Block {
        If {
          Call(target=httpRequestDone) { Var(name=state) }
          Block { Return { Call(target=httpRequestResponse) { Var(name=state) } } }
          Block {
            If {
              Call(target=httpRequestFailed) { Var(name=state) }
              Block { Return { Lit(value="") } }
              Block {
                Let(name=phase) { Call(target=httpRequestPhase) { Var(name=state) } }
                If {
                  Eq { Var(name=phase) Lit(value="connecting") }
                  Block {
                    Call(target=sys.net.async.await) { Call(target=httpRequestOp) { Var(name=state) } }
                    Return { Call(target=httpRequestAwait) { Call(target=httpRequestPoll) { Var(name=state) } } }
                  }
                  Block {
                    If {
                      Eq { Var(name=phase) Lit(value="writing") }
                      Block {
                        Call(target=sys.net.async.await) { Call(target=httpRequestOp) { Var(name=state) } }
                        Return { Call(target=httpRequestAwait) { Call(target=httpRequestPoll) { Var(name=state) } } }
                      }
                      Block {
                        If {
                          Eq { Var(name=phase) Lit(value="reading") }
                          Block {
                            Call(target=sys.net.async.await) { Call(target=httpRequestOp) { Var(name=state) } }
                            Return { Call(target=httpRequestAwait) { Call(target=httpRequestPoll) { Var(name=state) } } }
                          }
                          Block { Return { Lit(value="") } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

