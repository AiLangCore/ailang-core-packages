              Block {
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="reading")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Call(target=httpRequestOp) { Var(name=state) }
                    Call(target=httpRequestConnection) { Var(name=state) }
                    Lit(value="")
                    Lit(value="")
                    Lit(value="")
                    Add { Var(name=remaining) Lit(value=-1) }
                  }
                }
              }
            }
          }
          Block {
            If {
              Eq { Var(name=status) Lit(value=1) }
              Block { Lit(value=0) }
              Block {
                Call(target=sys.net.tcp.close) { Var(name=connection) }
                Return {
                  Call(target=httpMakeRequestState) {
                    Lit(value="error")
                    Call(target=httpRequestText) { Var(name=state) }
                    Call(target=httpRequestMaxBytes) { Var(name=state) }
                    Lit(value=0)
                    Lit(value=-1)
                    Lit(value="")
                    Lit(value="")
                    Lit(value="read_failed")
                    Lit(value=0)
                  }
                }
              }
            }
            Let(name=responseBytesText) { Call(target=sys.net.async.resultBytes) { Var(name=op) } }
            Let(name=response) { Call(target=bytes.toUtf8String) { Var(name=responseBytesText) } }
            Let(name=responseBytesBase64) {
              Call(target=bytes.toBase64) {
