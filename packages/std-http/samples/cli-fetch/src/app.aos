Program {
  Import(package="std-http" path="src/net/http.aos")
  Import(sdk="ailang" path="std/str.aos")
  Import(sdk="ailang" path="std/io.aos")

  Export(name=start)
  Export(name=formatWeather)
  Export(name=getWeatherText)

  Let(name=sampleCliText) { Lit(value="Weather for London: London: +22C") }
  Export(name=sampleCliText)

  Let(name=textLen) {
    Fn(params=text) {
      Block {
        If {
          Eq { Var(name=text) Lit(value="") }
          Block { Return { Lit(value=0) } }
          Block {
            Return {
              Add {
                Lit(value=1)
                Call(target=textLen) {
                  Call(target=substring) {
                    Var(name=text)
                    Lit(value=1)
                    Lit(value=2147483647)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=findSpace) {
    Fn(params=text,index) {
      Block {
        If {
          Eq { Var(name=index) Call(target=textLen) { Var(name=text) } }
          Block { Return { Lit(value=-1) } }
          Block {
            If {
              Eq { Call(target=substring) { Var(name=text) Var(name=index) Lit(value=1) } Lit(value=" ") }
              Block { Return { Var(name=index) } }
              Block { Return { Call(target=findSpace) { Var(name=text) Add { Var(name=index) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }

  Let(name=replaceSpaces) {
    Fn(params=text) {
      Block {
        Let(name=spacePos) { Call(target=findSpace) { Var(name=text) Lit(value=0) } }
        If {
          Eq { Var(name=spacePos) Lit(value=-1) }
          Block { Return { Var(name=text) } }
          Block {
            Let(name=prefix) { Call(target=substring) { Var(name=text) Lit(value=0) Var(name=spacePos) } }
            Let(name=suffixStart) { Add { Var(name=spacePos) Lit(value=1) } }
            Let(name=suffixLen) { Lit(value=2147483647) }
            Let(name=suffix) { Call(target=substring) { Var(name=text) Var(name=suffixStart) Var(name=suffixLen) } }
            Return {
              Call(target=replaceSpaces) {
                StrConcat {
                  Var(name=prefix)
                  StrConcat {
                    Lit(value="+")
                    Var(name=suffix)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=getWeatherText) {
    Fn(params=city) {
      Block {
        Let(name=cityEncoded) { Call(target=replaceSpaces) { Var(name=city) } }
        Return {
          Call(target=httpRequestAwaitBody) {
            Call(target=httpRequest) {
              Lit(value="GET")
              Lit(value="wttr.in")
              Lit(value=443)
              StrConcat {
                Lit(value="/")
                StrConcat {
                  Var(name=cityEncoded)
                  Lit(value="?format=3")
                }
              }
              Lit(value="")
              Lit(value="")
              Lit(value=16384)
            }
          }
        }
      }
    }
  }

  Let(name=formatWeather) {
    Fn(params=city) {
      Block {
        Let(name=bodyJson) { Call(target=getWeatherText) { Var(name=city) } }
        Return {
          StrConcat {
            Lit(value="Weather for ")
            StrConcat {
              Var(name=city)
              StrConcat {
                Lit(value=": ")
                Var(name=bodyJson)
              }
            }
          }
        }
      }
    }
  }

  Let(name=start) {
    Fn(params=args) {
      Block {
        Let(name=city) {
          If {
            Eq { ChildCount { Var(name=args) } Lit(value=0) }
            Block { Lit(value="London") }
            Block { AttrValueString { ChildAt { Var(name=args) Lit(value=0) } Lit(value=0) } }
          }
        }
        Call(target=println) { Call(target=formatWeather) { Var(name=city) } }
        Return { Lit(value=0) }
      }
    }
  }

  Call(target=start) { Var(name=argv) }
}
