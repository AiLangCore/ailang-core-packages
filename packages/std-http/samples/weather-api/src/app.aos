Program {
  Import(package="std-http" path="src/net/http.aos")

  Let(name=sampleWeatherJson) {
    Lit(value="{\"message\":\"AiLang weather API response\",\"city\":\"Fort Worth\",\"report\":\"Fort Worth: +22C\"}")
  }

  Let(name=init) {
    Fn(params=args) {
      Block { Return { MakeBlock { Lit(value="state") } } }
    }
  }

  Let(name=getWeatherText) {
    Fn(params=city) {
      Block {
        Return {
          Call(target=httpRequestAwait) {
            Call(target=httpRequest) {
            Lit(value="GET")
            Lit(value="wttr.in")
            Lit(value=443)
            StrConcat {
              Lit(value="/")
              StrConcat {
                Var(name=city)
                Lit(value="?format=3")
              }
            }
            Lit(value="")
            Lit(value="")
            Lit(value=16384)
            }
          }
        }
      }
    }
  }

  Let(name=buildWeatherJson) {
    Fn(params=city,report) {
      Block {
        Return {
          StrConcat {
            Lit(value="{\"message\":\"AiLang weather API response\",\"city\":\"")
            StrConcat {
              StrEscape { Var(name=city) }
              StrConcat {
                Lit(value="\",\"report\":\"")
                StrConcat {
                  StrEscape { Var(name=report) }
                  Lit(value="\"}")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=buildWeatherXml) {
    Fn(params=city,report) {
      Block {
        Return {
          StrConcat {
            Lit(value="<weather><message>AiLang weather API response</message><city>")
            StrConcat {
              Var(name=city)
              StrConcat {
                Lit(value="</city><report>")
                StrConcat {
                  Var(name=report)
                  Lit(value="</report></weather>")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=buildWeatherCsv) {
    Fn(params=city,report) {
      Block {
        Return {
          StrConcat {
            Lit(value="message,city,report\nAiLang weather API response,")
            StrConcat {
              Var(name=city)
              StrConcat {
                Lit(value=",")
                Var(name=report)
              }
            }
          }
        }
      }
    }
  }

  Let(name=buildWeatherToon) {
    Fn(params=city,report) {
      Block {
        Return {
          StrConcat {
            Lit(value="TOON(city=\"")
            StrConcat {
              StrEscape { Var(name=city) }
              StrConcat {
                Lit(value="\",report=\"")
                StrConcat {
                  StrEscape { Var(name=report) }
                  Lit(value="\")")
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=selectContentType) {
    Fn(params=accept) {
      Block {
        If {
          Eq { Var(name=accept) Lit(value="text/plain") }
          Block { Return { Lit(value="text/plain") } }
          Block {
            If {
              Eq { Var(name=accept) Lit(value="text/csv") }
              Block { Return { Lit(value="text/csv") } }
              Block {
                If {
                  Eq { Var(name=accept) Lit(value="application/xml") }
                  Block { Return { Lit(value="application/xml") } }
                  Block {
                    If {
                      Eq { Var(name=accept) Lit(value="text/xml") }
                      Block { Return { Lit(value="text/xml") } }
                      Block {
                        If {
                          Eq { Var(name=accept) Lit(value="text/toon") }
                          Block { Return { Lit(value="text/toon") } }
                          Block { Return { Lit(value="application/json") } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatWeatherByAccept) {
    Fn(params=city,report,contentType) {
      Block {
        If {
          Eq { Var(name=contentType) Lit(value="text/plain") }
          Block { Return { Var(name=report) } }
          Block {
            If {
              Eq { Var(name=contentType) Lit(value="text/csv") }
              Block { Return { Call(target=buildWeatherCsv) { Var(name=city) Var(name=report) } } }
              Block {
                If {
                  Eq { Var(name=contentType) Lit(value="application/xml") }
                  Block { Return { Call(target=buildWeatherXml) { Var(name=city) Var(name=report) } } }
                  Block {
                    If {
                      Eq { Var(name=contentType) Lit(value="text/xml") }
                      Block { Return { Call(target=buildWeatherXml) { Var(name=city) Var(name=report) } } }
                      Block {
                        If {
                          Eq { Var(name=contentType) Lit(value="text/toon") }
                          Block { Return { Call(target=buildWeatherToon) { Var(name=city) Var(name=report) } } }
                          Block { Return { Call(target=buildWeatherJson) { Var(name=city) Var(name=report) } } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=respondError) {
    Fn(params=state,status,reason,code,message) {
      Block {
        Let(name=body) { Call(target=httpErrorJson) { Var(name=code) Var(name=message) } }
        Let(name=response) { Call(target=httpResponse) { Var(name=status) Var(name=reason) Lit(value="application/json") Var(name=body) } }
        Return { Call(target=httpEmitRaw) { Var(name=state) Var(name=response) } }
      }
    }
  }

  Let(name=update) {
    Fn(params=state,event) {
      Block {
        Let(name=reqPayload) { AttrValueString { Var(name=event) Lit(value=0) } }
        Let(name=req) { Call(target=compiler.parseHttpRequest) { Var(name=reqPayload) } }
        Let(name=reqPath) { Call(target=httpPath) { Var(name=req) } }
        If {
          Eq { Var(name=reqPath) Lit(value="/weather") }
          Block {
            Let(name=city) { Call(target=httpQueryGet) { Var(name=req) Lit(value="city") Lit(value="") } }
            Let(name=acceptRaw) { Call(target=httpHeaderGet) { Var(name=req) Lit(value="Accept") Lit(value="") } }
            Let(name=accept) {
              If {
                Eq { Var(name=acceptRaw) Lit(value="") }
                Block { Call(target=httpHeaderGet) { Var(name=req) Lit(value="accept") Lit(value="application/json") } }
                Block { Var(name=acceptRaw) }
              }
            }
            Let(name=contentType) { Call(target=selectContentType) { Var(name=accept) } }
            If {
              Eq { Var(name=city) Lit(value="") }
              Block {
                Return {
                  Call(target=respondError) {
                    Var(name=state)
                    Lit(value=400)
                    Lit(value="Bad Request")
                    Lit(value="CITY_REQUIRED")
                    Lit(value="Query parameter 'city' is required.")
                  }
                }
              }
              Block {
                Let(name=weatherText) { Call(target=getWeatherText) { Var(name=city) } }
                If {
                  Eq { Var(name=weatherText) Lit(value="") }
                  Block {
                    Return {
                      Call(target=respondError) {
                        Var(name=state)
                        Lit(value=502)
                        Lit(value="Bad Gateway")
                        Lit(value="UPSTREAM_UNAVAILABLE")
                        Lit(value="Weather provider returned no data.")
                      }
                    }
                  }
                  Block {
                    Let(name=body) {
                      Call(target=formatWeatherByAccept) {
                        Var(name=city)
                        Var(name=weatherText)
                        Var(name=contentType)
                      }
                    }
                    Let(name=response) {
                      Call(target=httpResponse) {
                        Lit(value=200)
                        Lit(value="OK")
                        Var(name=contentType)
                        Var(name=body)
                      }
                    }
                    Return { Call(target=httpEmitRaw) { Var(name=state) Var(name=response) } }
                  }
                }
              }
            }
          }
          Block {
            Return {
              Call(target=respondError) {
                Var(name=state)
                Lit(value=404)
                Lit(value="Not Found")
                Lit(value="NOT_FOUND")
                Lit(value="Route not found.")
              }
            }
          }
        }
      }
    }
  }

  Let(name=start) {
    Fn(params=args) {
      Block { Return { Lit(value=0) } }
    }
  }

  Export(name=init)
  Export(name=update)
  Export(name=start)
  Export(name=getWeatherText)
  Export(name=sampleWeatherJson)
  Export(name=formatWeatherByAccept)
  Export(name=selectContentType)
}
