Program {
  Import(package="std-http" path="src/net/http.aos")

  Let(name=sampleHomeHtml) {
    Lit(value="<html><body><h1>AiLang Weather Site</h1><p>This page fetches live weather from the same upstream provider used by weather-api.</p><p>Try the API at <code>/weather?city=Fort%20Worth</code> on the weather-api sample.</p><p>Fort Worth</p><pre>Fort Worth: +22C</pre></body></html>")
  }

  Let(name=init) {
    Fn(params=args) {
      Block { Return { MakeBlock { Lit(value="state") } } }
    }
  }

  Let(name=getWeatherText) {
    Fn(params=city) {
      Block {
        Return {
          Call(target=httpRequestAwait) {
            Call(target=httpRequest) {
            Lit(value="GET")
            Lit(value="wttr.in")
            Lit(value=443)
            StrConcat {
              Lit(value="/")
              StrConcat {
                Var(name=city)
                Lit(value="?format=3")
              }
            }
            Lit(value="")
            Lit(value="")
            Lit(value=16384)
            }
          }
        }
      }
    }
  }

  Let(name=renderHomeHtml) {
    Fn(params=_) {
      Block {
        Let(name=report) { Call(target=getWeatherText) { Lit(value="Fort Worth") } }
        Return {
          StrConcat {
            Lit(value="<html><body><h1>AiLang Weather Site</h1><p>This page fetches live weather from the same upstream provider used by weather-api.</p><p>Try the API at <code>/weather?city=Fort%20Worth</code> on the weather-api sample.</p><p>Fort Worth</p><pre>")
            StrConcat {
              Var(name=report)
              Lit(value="</pre></body></html>")
            }
          }
        }
      }
    }
  }

  Let(name=update) {
    Fn(params=state,event) {
      Block {
        Let(name=reqPayload) { AttrValueString { Var(name=event) Lit(value=0) } }
        Let(name=req) { Call(target=compiler.parseHttpRequest) { Var(name=reqPayload) } }
        Let(name=reqPath) { Call(target=httpPath) { Var(name=req) } }
        If {
          Eq { Var(name=reqPath) Lit(value="/") }
          Block {
            Let(name=htmlText) { Call(target=renderHomeHtml) { Lit(value=0) } }
            Let(name=httpText) {
              Call(target=httpResponse) {
                Lit(value=200)
                Lit(value="OK")
                Lit(value="text/html; charset=utf-8")
                Var(name=htmlText)
              }
            }
            Return { Call(target=httpEmitRaw) { Var(name=state) Var(name=httpText) } }
          }
          Block {
            Let(name=errBody) { Call(target=httpErrorJson) { Lit(value="NOT_FOUND") Lit(value="Route not found.") } }
            Let(name=http404) {
              Call(target=httpResponse) {
                Lit(value=404)
                Lit(value="Not Found")
                Lit(value="application/json")
                Var(name=errBody)
              }
            }
            Return { Call(target=httpEmitRaw) { Var(name=state) Var(name=http404) } }
          }
        }
      }
    }
  }

  Let(name=start) {
    Fn(params=args) {
      Block { Return { Lit(value=0) } }
    }
  }

  Export(name=init)
  Export(name=update)
  Export(name=start)
  Export(name=renderHomeHtml)
  Export(name=sampleHomeHtml)
  Export(name=getWeatherText)
}
