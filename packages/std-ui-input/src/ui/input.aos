Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(path="event.aos")
  Import(sdk="ailang" path="std/str.aos")

  Let(name=isBackspaceKey) {
    Fn(params=key) {
      Block {
        Return { Eq { Var(name=key) Lit(value="backspace") } }
      }
    }
  }

  Let(name=isDeleteKey) {
    Fn(params=key) {
      Block {
        Return { Eq { Var(name=key) Lit(value="delete") } }
      }
    }
  }

  Let(name=isEnterKey) {
    Fn(params=key) {
      Block {
        Return { Eq { Var(name=key) Lit(value="enter") } }
      }
    }
  }

  Let(name=isArrowKey) {
    Fn(params=key) {
      Block {
        If {
          Eq { Var(name=key) Lit(value="left") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="right") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="up") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="down") }
          Block { Return { Lit(value=true) } }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=sanitizePrintableText) {
    Fn(params=text) {
      Block {
        If {
          Eq { Var(name=text) Lit(value="") }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=text) Lit(value="\t") }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=text) Lit(value="\r") }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=text) Lit(value="\n") }
          Block { Return { Lit(value="") } }
          Block { Return { Var(name=text) } }
        }
      }
    }
  }

  Let(name=inputKeyToText) {
    Fn(params=key,text,allowEnter,allowTab) {
      Block {
        Let(name=normalizedText) { Call(target=sanitizePrintableText) { Var(name=text) } }
        If {
          Eq { Var(name=key) Lit(value="space") }
          Block { Return { Lit(value=" ") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="tab") }
          Block {
            If {
              Var(name=allowTab)
              Block { Return { Lit(value="\t") } }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="enter") }
          Block {
            If {
              Var(name=allowEnter)
              Block { Return { Lit(value="\n") } }
              Block { Return { Lit(value="") } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isBackspaceKey) { Var(name=key) }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isDeleteKey) { Var(name=key) }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isArrowKey) { Var(name=key) }
          Block { Return { Lit(value="") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="escape") }
          Block { Return { Lit(value="") } }
          Block { Return { Var(name=normalizedText) } }
        }
      }
    }
  }

  Let(name=textLengthAt) {
    Fn(params=text,index) {
      Block {
        If {
          Eq {
            Call(target=substring) {
              Var(name=text)
              Var(name=index)
              Lit(value=1)
            }
            Lit(value="")
          }
          Block { Return { Var(name=index) } }
          Block {
            Return {
              Call(target=textLengthAt) {
                Var(name=text)
                Add { Var(name=index) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=textLength) {
    Fn(params=text) {
      Block {
        Return { Call(target=textLengthAt) { Var(name=text) Lit(value=0) } }
      }
    }
  }

  Let(name=editNextText) {
    Fn(params=text,cursor,key,eventText,allowEnter,allowTab) {
      Block {
        If {
          Call(target=isBackspaceKey) { Var(name=key) }
          Block {
            If {
              Eq { Var(name=cursor) Lit(value=0) }
              Block { Return { Var(name=text) } }
              Block {
                Return {
                  Call(target=remove) {
                    Var(name=text)
                    Add { Var(name=cursor) Lit(value=-1) }
                    Lit(value=1)
                  }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isDeleteKey) { Var(name=key) }
          Block {
            If {
              Eq {
                Call(target=substring) {
                  Var(name=text)
                  Var(name=cursor)
                  Lit(value=1)
                }
                Lit(value="")
              }
              Block { Return { Var(name=text) } }
              Block {
                Return {
                  Call(target=remove) {
                    Var(name=text)
                    Var(name=cursor)
                    Lit(value=1)
                  }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isArrowKey) { Var(name=key) }
          Block { Return { Var(name=text) } }
          Block { Lit(value=0) }
        }
        Let(name=insertText) {
          Call(target=inputKeyToText) {
            Var(name=key)
            Var(name=eventText)
            Var(name=allowEnter)
            Var(name=allowTab)
          }
        }
        If {
          Eq { Var(name=insertText) Lit(value="") }
          Block { Return { Var(name=text) } }
          Block {
            Let(name=prefix) {
              Call(target=substring) {
                Var(name=text)
                Lit(value=0)
                Var(name=cursor)
              }
            }
            Let(name=suffix) {
              Call(target=substring) {
                Var(name=text)
                Var(name=cursor)
                Call(target=textLength) { Var(name=text) }
              }
            }
            Return {
              StrConcat {
                StrConcat {
                  Var(name=prefix)
                  Var(name=insertText)
                }
                Var(name=suffix)
              }
            }
          }
        }
      }
    }
  }

  Let(name=editNextCursor) {
    Fn(params=text,cursor,key,eventText,allowEnter,allowTab) {
      Block {
        If {
          Eq { Var(name=key) Lit(value="left") }
          Block {
            If {
              Eq { Var(name=cursor) Lit(value=0) }
              Block { Return { Lit(value=0) } }
              Block { Return { Add { Var(name=cursor) Lit(value=-1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="right") }
          Block {
            If {
              Eq {
                Call(target=substring) {
                  Var(name=text)
                  Var(name=cursor)
                  Lit(value=1)
                }
                Lit(value="")
              }
              Block { Return { Var(name=cursor) } }
              Block { Return { Add { Var(name=cursor) Lit(value=1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isBackspaceKey) { Var(name=key) }
          Block {
            If {
              Eq { Var(name=cursor) Lit(value=0) }
              Block { Return { Lit(value=0) } }
              Block { Return { Add { Var(name=cursor) Lit(value=-1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isDeleteKey) { Var(name=key) }
          Block { Return { Var(name=cursor) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="up") }
          Block { Return { Var(name=cursor) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=key) Lit(value="down") }
          Block { Return { Var(name=cursor) } }
          Block { Lit(value=0) }
        }
        Let(name=insertText) {
          Call(target=inputKeyToText) {
            Var(name=key)
            Var(name=eventText)
            Var(name=allowEnter)
            Var(name=allowTab)
          }
        }
        If {
          Eq { Var(name=insertText) Lit(value="") }
          Block { Return { Var(name=cursor) } }
          Block {
            Return {
              Add {
                Var(name=cursor)
                Call(target=textLength) { Var(name=insertText) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=editShouldSubmit) {
    Fn(params=key,allowEnter) {
      Block {
        If {
          Eq { Var(name=key) Lit(value="enter") }
          Block {
            If {
              Var(name=allowEnter)
              Block { Return { Lit(value=false) } }
              Block { Return { Lit(value=true) } }
            }
          }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=editDebugToken) {
    Fn(params=key,eventText,allowEnter,allowTab) {
      Block {
        If {
          Call(target=isBackspaceKey) { Var(name=key) }
          Block { Return { Lit(value="backspace") } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isDeleteKey) { Var(name=key) }
          Block { Return { Lit(value="delete") } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=isArrowKey) { Var(name=key) }
          Block { Return { Lit(value="move") } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=editShouldSubmit) { Var(name=key) Var(name=allowEnter) }
          Block { Return { Lit(value="submit") } }
          Block { Lit(value=0) }
        }
        Let(name=insertText) {
          Call(target=inputKeyToText) {
            Var(name=key)
            Var(name=eventText)
            Var(name=allowEnter)
            Var(name=allowTab)
          }
        }
        If {
          Eq { Var(name=insertText) Lit(value="") }
          Block { Return { Lit(value="noop") } }
          Block { Return { Lit(value="insert") } }
        }
      }
    }
  }

  Let(name=shouldHandleKeyEvent) {
    Fn(params=eventType,focusedId,targetId) {
      Block {
        If {
          Eq { Var(name=eventType) Lit(value="key") }
          Block { Lit(value=0) }
          Block { Return { Lit(value=false) } }
        }
        If {
          Eq { Var(name=focusedId) Lit(value="") }
          Block { Return { Lit(value=false) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=targetId) Lit(value="") }
          Block { Return { Lit(value=true) } }
          Block { Return { Eq { Var(name=targetId) Var(name=focusedId) } } }
        }
      }
    }
  }

  Let(name=nextFocusOnClick) {
    Fn(params=eventType,targetId,currentFocus) {
      Block {
        If {
          Eq { Var(name=eventType) Lit(value="click") }
          Block { Lit(value=0) }
          Block { Return { Var(name=currentFocus) } }
        }
        If {
          Eq { Var(name=targetId) Lit(value="") }
          Block { Return { Lit(value="") } }
          Block { Return { Var(name=targetId) } }
        }
      }
    }
  }

  Let(name=inputEventResolvedText) {
    Fn(params=event,allowEnter,allowTab) {
      Block {
        Let(name=textValue) { Call(target=inputEventText) { Var(name=event) } }
        If {
          Eq { Var(name=textValue) Lit(value="") }
          Block {
            Return {
              Call(target=inputKeyToText) {
                Call(target=inputEventKey) { Var(name=event) }
                Var(name=textValue)
                Var(name=allowEnter)
                Var(name=allowTab)
              }
            }
          }
          Block { Return { Var(name=textValue) } }
        }
      }
    }
  }

  Export(name=isBackspaceKey)
  Export(name=isDeleteKey)
  Export(name=isEnterKey)
  Export(name=isArrowKey)
  Export(name=inputKeyToText)
  Export(name=textLength)
  Export(name=editNextText)
  Export(name=editNextCursor)
  Export(name=editShouldSubmit)
  Export(name=editDebugToken)
  Export(name=shouldHandleKeyEvent)
  Export(name=nextFocusOnClick)
  Export(name=inputEventType)
  Export(name=inputEventKey)
  Export(name=inputEventText)
  Export(name=inputEventX)
  Export(name=inputEventY)
  Export(name=inputEventDeltaX)
  Export(name=inputEventDeltaY)
  Export(name=inputEventTargetId)
  Export(name=inputEventIsClickLike)
  Export(name=inputEventIsPointerDownLike)
  Export(name=inputEventIsPointerUpLike)
  Export(name=inputEventIsMoveLike)
  Export(name=inputEventIsTextLike)
  Export(name=inputEventIsKeyboardLike)
  Export(name=inputEventResolvedText)
  Export(name=inputEventTargets)
}
