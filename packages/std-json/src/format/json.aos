Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(sdk="ailang" path="std/str.aos")
  Import(path="stringify.aos")

  Let(name=encode) {
    Fn(params=node) {
      Block {
        Return { Call(target=std.json.stringify) { Var(name=node) } }
      }
    }
  }

  Let(name=charAt) {
    Fn(params=text,index) {
      Block {
        Return {
          Call(target=substring) {
            Var(name=text)
            Var(name=index)
            Lit(value=1)
          }
        }
      }
    }
  }

  Let(name=textLengthAt) {
    Fn(params=text,index) {
      Block {
        If {
          Eq { Call(target=charAt) { Var(name=text) Var(name=index) } Lit(value="") }
          Block { Return { Var(name=index) } }
          Block {
            Return {
              Call(target=textLengthAt) {
                Var(name=text)
                Add { Var(name=index) Lit(value=1) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=textLength) {
    Fn(params=text) {
      Block { Return { Call(target=textLengthAt) { Var(name=text) Lit(value=0) } } }
    }
  }

  Let(name=isWsChar) {
    Fn(params=ch) {
      Block {
        If {
          Eq { Var(name=ch) Lit(value=" ") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="\n") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="\r") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="\t") }
          Block { Return { Lit(value=true) } }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=skipWsFrom) {
    Fn(params=text,index,len) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Var(name=index) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Call(target=isWsChar) { Var(name=ch) }
              Block {
                Return {
                  Call(target=skipWsFrom) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                  }
                }
              }
              Block { Return { Var(name=index) } }
            }
          }
        }
      }
    }
  }

  Let(name=allWsFrom) {
    Fn(params=text,index,len) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Lit(value=true) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Call(target=isWsChar) { Var(name=ch) }
              Block {
                Return {
                  Call(target=allWsFrom) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                  }
                }
              }
              Block { Return { Lit(value=false) } }
            }
          }
        }
      }
    }
  }

  Let(name=startsWithAt) {
    Fn(params=text,start,token) {
      Block {
        Let(name=tokenLen) { Call(target=textLength) { Var(name=token) } }
        Return {
          Eq {
            Call(target=substring) {
              Var(name=text)
              Var(name=start)
              Var(name=tokenLen)
            }
            Var(name=token)
          }
        }
      }
    }
  }

  Let(name=scanNumberToken) {
    Fn(params=text,index,len,acc) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Var(name=acc) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Eq { Var(name=ch) Lit(value="0") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="1") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="2") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="3") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="4") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="5") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="6") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="7") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="8") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="9") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="-") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="+") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value=".") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="e") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="E") }
              Block {
                Return {
                  Call(target=scanNumberToken) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    StrConcat { Var(name=acc) Var(name=ch) }
                  }
                }
              }
              Block { Return { Var(name=acc) } }
            }
          }
        }
      }
    }
  }

  Let(name=containsDigitAt) {
    Fn(params=text,index,len) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Eq { Var(name=ch) Lit(value="0") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="1") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="2") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="3") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="4") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="5") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="6") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="7") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="8") }
              Block { Return { Lit(value=true) } }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="9") }
              Block { Return { Lit(value=true) } }
              Block {
                Return {
                  Call(target=containsDigitAt) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=findStringClose) {
    Fn(params=text,index,len,escaped) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Lit(value=-1) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Var(name=escaped)
              Block {
                Return {
                  Call(target=findStringClose) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    Lit(value=false)
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="\\") }
              Block {
                Return {
                  Call(target=findStringClose) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    Lit(value=true)
                  }
                }
              }
              Block { Lit(value=0) }
            }
            If {
              Eq { Var(name=ch) Lit(value="\"") }
              Block { Return { Var(name=index) } }
              Block {
                Return {
                  Call(target=findStringClose) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=len)
                    Lit(value=false)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=collectTokenRange) {
    Fn(params=text,index,endExclusive,acc) {
      Block {
        If {
          Eq { Var(name=index) Var(name=endExclusive) }
          Block { Return { Var(name=acc) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            Return {
              Call(target=collectTokenRange) {
                Var(name=text)
                Add { Var(name=index) Lit(value=1) }
                Var(name=endExclusive)
                StrConcat { Var(name=acc) Var(name=ch) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=findCompositeClose) {
    Fn(params=text,index,len,openCh,closeCh,depth,inString,escaped) {
      Block {
        If {
          Eq { Var(name=index) Var(name=len) }
          Block { Return { Lit(value=-1) } }
          Block {
            Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
            If {
              Var(name=inString)
              Block {
                If {
                  Var(name=escaped)
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=true)
                        Lit(value=false)
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { Var(name=ch) Lit(value="\\") }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=true)
                        Lit(value=true)
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { Var(name=ch) Lit(value="\"") }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=false)
                        Lit(value=false)
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=true)
                        Lit(value=false)
                      }
                    }
                  }
                }
              }
              Block {
                If {
                  Eq { Var(name=ch) Lit(value="\"") }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=true)
                        Lit(value=false)
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { Var(name=ch) Var(name=openCh) }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Add { Var(name=depth) Lit(value=1) }
                        Lit(value=false)
                        Lit(value=false)
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
                If {
                  Eq { Var(name=ch) Var(name=closeCh) }
                  Block {
                    If {
                      Eq { Var(name=depth) Lit(value=1) }
                      Block { Return { Var(name=index) } }
                      Block {
                        Return {
                          Call(target=findCompositeClose) {
                            Var(name=text)
                            Add { Var(name=index) Lit(value=1) }
                            Var(name=len)
                            Var(name=openCh)
                            Var(name=closeCh)
                            Add { Var(name=depth) Lit(value=-1) }
                            Lit(value=false)
                            Lit(value=false)
                          }
                        }
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=findCompositeClose) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=len)
                        Var(name=openCh)
                        Var(name=closeCh)
                        Var(name=depth)
                        Lit(value=false)
                        Lit(value=false)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=makeJsonNodeFromToken) {
    Fn(params=token) {
      Block {
        If {
          Eq { Var(name=token) Lit(value="null") }
          Block { Return { Call(target=nodeEmpty) { Lit(value="JsonNull") } } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=token) Lit(value="true") }
          Block {
            Return {
              Call(target=nodeWithBool) {
                Lit(value="JsonBool")
                Lit(value="value")
                Lit(value=true)
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=token) Lit(value="false") }
          Block {
            Return {
              Call(target=nodeWithBool) {
                Lit(value="JsonBool")
                Lit(value="value")
                Lit(value=false)
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=first) { Call(target=charAt) { Var(name=token) Lit(value=0) } }
        If {
          Eq { Var(name=first) Lit(value="\"") }
          Block {
            Let(name=decoded) { Call(target=decodeJsonStringToken) { Var(name=token) } }
            Let(name=baseNode) {
              Call(target=nodeWithString) {
                Lit(value="JsonString")
                Lit(value="value")
                Var(name=decoded)
              }
            }
            Return {
              AppendChild {
                Var(name=baseNode)
                MakeLitString {
                  Lit(value="raw")
                  Var(name=token)
                }
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="{") }
          Block {
            Return {
              Call(target=nodeWithString) {
                Lit(value="JsonObject")
                Lit(value="raw")
                Var(name=token)
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="[") }
          Block {
            Return {
              Call(target=nodeWithString) {
                Lit(value="JsonArray")
                Lit(value="raw")
                Var(name=token)
              }
            }
          }
          Block { Lit(value=0) }
        }
        Return {
          Call(target=nodeWithString) {
            Lit(value="JsonNumber")
            Lit(value="raw")
            Var(name=token)
          }
        }
      }
    }
  }

  Let(name=decodeEscapeChar) {
    Fn(params=ch) {
      Block {
        If {
          Eq { Var(name=ch) Lit(value="\"") }
          Block { Return { Lit(value="\"") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="\\") }
          Block { Return { Lit(value="\\") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="/") }
          Block { Return { Lit(value="/") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="b") }
          Block {
            Return {
              StrConcat {
                Lit(value="\\")
                Lit(value="b")
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="f") }
          Block {
            Return {
              StrConcat {
                Lit(value="\\")
                Lit(value="f")
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="n") }
          Block { Return { Lit(value="\n") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="r") }
          Block { Return { Lit(value="\r") } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="t") }
          Block { Return { Lit(value="\t") } }
          Block {
            Return {
              StrConcat {
                Lit(value="\\")
                Var(name=ch)
              }
            }
          }
        }
      }
    }
  }

  Let(name=decodeUnicodeHex4) {
    Fn(params=hex4) {
      Block {
        Return { Call(target=decodeUnicodeHex4) { Var(name=hex4) } }
      }
    }
  }

  Let(name=decodeUnicodeSurrogatePairHex4) {
    Fn(params=highHex4,lowHex4) {
      Block {
        Return {
          Call(target=decodeUnicodeSurrogatePairHex4) {
            Var(name=highHex4)
            Var(name=lowHex4)
          }
        }
      }
    }
  }

  Let(name=isHighSurrogateHex4) {
    Fn(params=hex4) {
      Block {
        Let(name=first) { Call(target=charAt) { Var(name=hex4) Lit(value=0) } }
        Let(name=second) { Call(target=charAt) { Var(name=hex4) Lit(value=1) } }
        If {
          Eq { Var(name=first) Lit(value="D") }
          Block { Lit(value=0) }
          Block {
            If {
              Eq { Var(name=first) Lit(value="d") }
              Block { Lit(value=0) }
              Block { Return { Lit(value=false) } }
            }
          }
        }
        If {
          Eq { Var(name=second) Lit(value="8") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=second) Lit(value="9") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=second) Lit(value="A") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=second) Lit(value="B") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=second) Lit(value="a") }
          Block { Return { Lit(value=true) } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=second) Lit(value="b") }
          Block { Return { Lit(value=true) } }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  Let(name=decodeStringBody) {
    Fn(params=text,index,endExclusive,escaped,acc) {
      Block {
        If {
          Eq { Var(name=index) Var(name=endExclusive) }
          Block { Return { Var(name=acc) } }
          Block { Lit(value=0) }
        }
        Let(name=ch) { Call(target=charAt) { Var(name=text) Var(name=index) } }
        If {
          Var(name=escaped)
          Block {
            If {
              Eq { Var(name=ch) Lit(value="u") }
              Block {
                Let(name=hex4) {
                  Call(target=substring) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Lit(value=4)
                  }
                }
                If {
                  Eq { Call(target=textLength) { Var(name=hex4) } Lit(value=4) }
                  Block {
                    Let(name=decoded) { Call(target=decodeUnicodeHex4) { Var(name=hex4) } }
                    If {
                      Eq { Var(name=decoded) Lit(value="") }
                      Block {
                        If {
                          Call(target=isHighSurrogateHex4) { Var(name=hex4) }
                          Block {
                            Let(name=tail) {
                              Call(target=substring) {
                                Var(name=text)
                                Add { Var(name=index) Lit(value=5) }
                                Lit(value=6)
                              }
                            }
                            If {
                              Eq { Call(target=textLength) { Var(name=tail) } Lit(value=6) }
                              Block {
                                If {
                                  Eq { Call(target=charAt) { Var(name=tail) Lit(value=0) } Lit(value="\\") }
                                  Block {
                                    If {
                                      Eq { Call(target=charAt) { Var(name=tail) Lit(value=1) } Lit(value="u") }
                                      Block {
                                        Let(name=lowHex4) {
                                          Call(target=substring) {
                                            Var(name=text)
                                            Add { Var(name=index) Lit(value=7) }
                                            Lit(value=4)
                                          }
                                        }
                                        If {
                                          Eq { Call(target=textLength) { Var(name=lowHex4) } Lit(value=4) }
                                          Block {
                                            Let(name=pairDecoded) {
                                              Call(target=decodeUnicodeSurrogatePairHex4) {
                                                Var(name=hex4)
                                                Var(name=lowHex4)
                                              }
                                            }
                                            If {
                                              Eq { Var(name=pairDecoded) Lit(value="") }
                                              Block { Lit(value=0) }
                                              Block {
                                                Return {
                                                  Call(target=decodeStringBody) {
                                                    Var(name=text)
                                                    Add { Var(name=index) Lit(value=11) }
                                                    Var(name=endExclusive)
                                                    Lit(value=false)
                                                    StrConcat { Var(name=acc) Var(name=pairDecoded) }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                          Block { Lit(value=0) }
                                        }
                                      }
                                      Block { Lit(value=0) }
                                    }
                                  }
                                  Block { Lit(value=0) }
                                }
                              }
                              Block { Lit(value=0) }
                            }
                          }
                          Block { Lit(value=0) }
                        }
                        Return {
                          Call(target=decodeStringBody) {
                            Var(name=text)
                            Add { Var(name=index) Lit(value=5) }
                            Var(name=endExclusive)
                            Lit(value=false)
                            StrConcat {
                              Var(name=acc)
                              StrConcat { Lit(value="\\u") Var(name=hex4) }
                            }
                          }
                        }
                      }
                      Block {
                        Return {
                          Call(target=decodeStringBody) {
                            Var(name=text)
                            Add { Var(name=index) Lit(value=5) }
                            Var(name=endExclusive)
                            Lit(value=false)
                            StrConcat { Var(name=acc) Var(name=decoded) }
                          }
                        }
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=decodeStringBody) {
                        Var(name=text)
                        Add { Var(name=index) Lit(value=1) }
                        Var(name=endExclusive)
                        Lit(value=false)
                        StrConcat { Var(name=acc) Lit(value="\\u") }
                      }
                    }
                  }
                }
              }
              Block {
                Return {
                  Call(target=decodeStringBody) {
                    Var(name=text)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=endExclusive)
                    Lit(value=false)
                    StrConcat { Var(name=acc) Call(target=decodeEscapeChar) { Var(name=ch) } }
                  }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=ch) Lit(value="\\") }
          Block {
            Return {
              Call(target=decodeStringBody) {
                Var(name=text)
                Add { Var(name=index) Lit(value=1) }
                Var(name=endExclusive)
                Lit(value=true)
                Var(name=acc)
              }
            }
          }
          Block {
            Return {
              Call(target=decodeStringBody) {
                Var(name=text)
                Add { Var(name=index) Lit(value=1) }
                Var(name=endExclusive)
                Lit(value=false)
                StrConcat { Var(name=acc) Var(name=ch) }
              }
            }
          }
        }
      }
    }
  }

  Let(name=decodeJsonStringToken) {
    Fn(params=token) {
      Block {
        Let(name=len) { Call(target=textLength) { Var(name=token) } }
        Return {
          Call(target=decodeStringBody) {
            Var(name=token)
            Lit(value=1)
            Add { Var(name=len) Lit(value=-1) }
            Lit(value=false)
            Lit(value="")
          }
        }
      }
    }
  }

  Let(name=parseValueTokenEnd) {
    Fn(params=text,start,len) {
      Block {
        If {
          Eq { Var(name=start) Var(name=len) }
          Block { Return { Lit(value=-1) } }
          Block { Lit(value=0) }
        }
        Let(name=first) { Call(target=charAt) { Var(name=text) Var(name=start) } }
        If {
          Eq { Var(name=first) Lit(value="\"") }
          Block {
            Let(name=closeIndex) {
              Call(target=findStringClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block { Return { Lit(value=-1) } }
              Block { Return { Add { Var(name=closeIndex) Lit(value=1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="{") }
          Block {
            Let(name=closeIndex) {
              Call(target=findCompositeClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value="{")
                Lit(value="}")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block { Return { Lit(value=-1) } }
              Block { Return { Add { Var(name=closeIndex) Lit(value=1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="[") }
          Block {
            Let(name=closeIndex) {
              Call(target=findCompositeClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value="[")
                Lit(value="]")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block { Return { Lit(value=-1) } }
              Block { Return { Add { Var(name=closeIndex) Lit(value=1) } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="true") }
          Block { Return { Add { Var(name=start) Lit(value=4) } } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="false") }
          Block { Return { Add { Var(name=start) Lit(value=5) } } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="null") }
          Block { Return { Add { Var(name=start) Lit(value=4) } } }
          Block { Lit(value=0) }
        }
        Let(name=numberToken) {
          Call(target=scanNumberToken) {
            Var(name=text)
            Var(name=start)
            Var(name=len)
            Lit(value="")
          }
        }
        If {
          Eq { Var(name=numberToken) Lit(value="") }
          Block { Return { Lit(value=-1) } }
          Block {
            Let(name=numberLen) { Call(target=textLength) { Var(name=numberToken) } }
            If {
              Call(target=containsDigitAt) { Var(name=numberToken) Lit(value=0) Var(name=numberLen) }
              Block { Return { Add { Var(name=start) Var(name=numberLen) } } }
              Block { Return { Lit(value=-1) } }
            }
          }
        }
      }
    }
  }

  Let(name=parseArrayItems) {
    Fn(params=text,index,closeIndex,arrayNode) {
      Block {
        Let(name=at) { Call(target=skipWsFrom) { Var(name=text) Var(name=index) Var(name=closeIndex) } }
        If {
          Eq { Var(name=at) Var(name=closeIndex) }
          Block { Return { Call(target=resultOkNode) { Var(name=arrayNode) } } }
          Block { Lit(value=0) }
        }
        Let(name=valueEnd) { Call(target=parseValueTokenEnd) { Var(name=text) Var(name=at) Var(name=closeIndex) } }
        If {
          Eq { Var(name=valueEnd) Lit(value=-1) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_ARRAY_VALUE")
                Lit(value="Array contains an invalid value.")
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=valueToken) { Call(target=collectTokenRange) { Var(name=text) Var(name=at) Var(name=valueEnd) Lit(value="") } }
        Let(name=valueParsed) { Call(target=parseNode) { Var(name=valueToken) } }
        If {
          Call(target=resultIsOk) { Var(name=valueParsed) }
          Block {
            Let(name=valueNode) { Call(target=resultNodeOr) { Var(name=valueParsed) Call(target=nodeEmpty) { Lit(value="JsonInvalid") } } }
            Let(name=nextArray) { AppendChild { Var(name=arrayNode) Var(name=valueNode) } }
            Let(name=afterValue) { Call(target=skipWsFrom) { Var(name=text) Var(name=valueEnd) Var(name=closeIndex) } }
            If {
              Eq { Var(name=afterValue) Var(name=closeIndex) }
              Block { Return { Call(target=resultOkNode) { Var(name=nextArray) } } }
              Block {
                If {
                  Eq { Call(target=charAt) { Var(name=text) Var(name=afterValue) } Lit(value=",") }
                  Block {
                    Return {
                      Call(target=parseArrayItems) {
                        Var(name=text)
                        Add { Var(name=afterValue) Lit(value=1) }
                        Var(name=closeIndex)
                        Var(name=nextArray)
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=resultErr) {
                        Lit(value="JSON_ARRAY_SEPARATOR")
                        Lit(value="Expected ',' between array elements.")
                      }
                    }
                  }
                }
              }
            }
          }
          Block { Return { Var(name=valueParsed) } }
        }
      }
    }
  }

  Let(name=parseObjectItems) {
    Fn(params=text,index,closeIndex,objNode) {
      Block {
        Let(name=at) { Call(target=skipWsFrom) { Var(name=text) Var(name=index) Var(name=closeIndex) } }
        If {
          Eq { Var(name=at) Var(name=closeIndex) }
          Block { Return { Call(target=resultOkNode) { Var(name=objNode) } } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Call(target=charAt) { Var(name=text) Var(name=at) } Lit(value="\"") }
          Block { Lit(value=0) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_KEY")
                Lit(value="Object key must be a quoted string.")
              }
            }
          }
        }
        Let(name=keyClose) {
          Call(target=findStringClose) {
            Var(name=text)
            Add { Var(name=at) Lit(value=1) }
            Var(name=closeIndex)
            Lit(value=false)
          }
        }
        If {
          Eq { Var(name=keyClose) Lit(value=-1) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_KEY")
                Lit(value="Object key string is not terminated.")
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=afterKey) { Call(target=skipWsFrom) { Var(name=text) Add { Var(name=keyClose) Lit(value=1) } Var(name=closeIndex) } }
        If {
          Eq { Var(name=afterKey) Var(name=closeIndex) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_COLON")
                Lit(value="Expected ':' after object key.")
              }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Call(target=charAt) { Var(name=text) Var(name=afterKey) } Lit(value=":") }
          Block { Lit(value=0) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_COLON")
                Lit(value="Expected ':' after object key.")
              }
            }
          }
        }
        Let(name=valueStart) { Call(target=skipWsFrom) { Var(name=text) Add { Var(name=afterKey) Lit(value=1) } Var(name=closeIndex) } }
        If {
          Eq { Var(name=valueStart) Var(name=closeIndex) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_VALUE")
                Lit(value="Missing object value.")
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=valueEnd) { Call(target=parseValueTokenEnd) { Var(name=text) Var(name=valueStart) Var(name=closeIndex) } }
        If {
          Eq { Var(name=valueEnd) Lit(value=-1) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_OBJECT_VALUE")
                Lit(value="Object value is invalid.")
              }
            }
          }
          Block { Lit(value=0) }
        }
        Let(name=valueToken) { Call(target=collectTokenRange) { Var(name=text) Var(name=valueStart) Var(name=valueEnd) Lit(value="") } }
        Let(name=valueParsed) { Call(target=parseNode) { Var(name=valueToken) } }
        If {
          Call(target=resultIsOk) { Var(name=valueParsed) }
          Block {
            Let(name=keyToken) { Call(target=collectTokenRange) { Var(name=text) Var(name=at) Add { Var(name=keyClose) Lit(value=1) } Lit(value="") } }
            Let(name=decodedKey) { Call(target=decodeJsonStringToken) { Var(name=keyToken) } }
            Let(name=valueNode) { Call(target=resultNodeOr) { Var(name=valueParsed) Call(target=nodeEmpty) { Lit(value="JsonInvalid") } } }
            Let(name=fieldNode) { Call(target=nodeWithString) { Lit(value="JsonField") Lit(value="key") Var(name=decodedKey) } }
            Let(name=fieldWithValue) { AppendChild { Var(name=fieldNode) Var(name=valueNode) } }
            Let(name=nextObj) { AppendChild { Var(name=objNode) Var(name=fieldWithValue) } }
            Let(name=afterValue) { Call(target=skipWsFrom) { Var(name=text) Var(name=valueEnd) Var(name=closeIndex) } }
            If {
              Eq { Var(name=afterValue) Var(name=closeIndex) }
              Block { Return { Call(target=resultOkNode) { Var(name=nextObj) } } }
              Block {
                If {
                  Eq { Call(target=charAt) { Var(name=text) Var(name=afterValue) } Lit(value=",") }
                  Block {
                    Return {
                      Call(target=parseObjectItems) {
                        Var(name=text)
                        Add { Var(name=afterValue) Lit(value=1) }
                        Var(name=closeIndex)
                        Var(name=nextObj)
                      }
                    }
                  }
                  Block {
                    Return {
                      Call(target=resultErr) {
                        Lit(value="JSON_OBJECT_SEPARATOR")
                        Lit(value="Expected ',' between object fields.")
                      }
                    }
                  }
                }
              }
            }
          }
          Block { Return { Var(name=valueParsed) } }
        }
      }
    }
  }

  Let(name=parseNodeTreeFromToken) {
    Fn(params=token) {
      Block {
        Let(name=first) { Call(target=charAt) { Var(name=token) Lit(value=0) } }
        If {
          Eq { Var(name=first) Lit(value="[") }
          Block {
            Let(name=len) { Call(target=textLength) { Var(name=token) } }
            Let(name=closeIndex) {
              Call(target=findCompositeClose) {
                Var(name=token)
                Lit(value=1)
                Var(name=len)
                Lit(value="[")
                Lit(value="]")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block {
                Return {
                  Call(target=resultErr) {
                    Lit(value="JSON_UNTERMINATED_ARRAY")
                    Lit(value="Array literal is not terminated.")
                  }
                }
              }
              Block { Return { Call(target=parseArrayItems) { Var(name=token) Lit(value=1) Var(name=closeIndex) Call(target=nodeEmpty) { Lit(value="JsonArray") } } } }
            }
          }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="{") }
          Block {
            Let(name=len) { Call(target=textLength) { Var(name=token) } }
            Let(name=closeIndex) {
              Call(target=findCompositeClose) {
                Var(name=token)
                Lit(value=1)
                Var(name=len)
                Lit(value="{")
                Lit(value="}")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block {
                Return {
                  Call(target=resultErr) {
                    Lit(value="JSON_UNTERMINATED_OBJECT")
                    Lit(value="Object literal is not terminated.")
                  }
                }
              }
              Block { Return { Call(target=parseObjectItems) { Var(name=token) Lit(value=1) Var(name=closeIndex) Call(target=nodeEmpty) { Lit(value="JsonObject") } } } }
            }
          }
          Block { Lit(value=0) }
        }
        Return { Call(target=resultOkNode) { Call(target=makeJsonNodeFromToken) { Var(name=token) } } }
      }
    }
  }

  Let(name=parseNode) {
    Fn(params=text) {
      Block {
        Let(name=parsed) { Call(target=parse) { Var(name=text) } }
        If {
          Call(target=resultIsOk) { Var(name=parsed) }
          Block {
            Let(name=token) { Call(target=resultValueOr) { Var(name=parsed) Lit(value="") } }
            Return { Call(target=parseNodeTreeFromToken) { Var(name=token) } }
          }
          Block {
            Return {
              Call(target=resultErr) {
                Call(target=resultCodeOr) { Var(name=parsed) Lit(value="JSON_PARSE_ERR") }
                Call(target=resultMessageOr) { Var(name=parsed) Lit(value="JSON parse failed.") }
              }
            }
          }
        }
      }
    }
  }

  Let(name=parse) {
    Fn(params=text) {
      Block {
        Let(name=len) { Call(target=textLength) { Var(name=text) } }
        Let(name=start) { Call(target=skipWsFrom) { Var(name=text) Lit(value=0) Var(name=len) } }
        Let(name=startCh) { Call(target=charAt) { Var(name=text) Var(name=start) } }

        If {
          Eq { Var(name=start) Var(name=len) }
          Block {
            Return {
              Call(target=resultErr) {
                Lit(value="JSON_EMPTY")
                Lit(value="JSON input is empty.")
              }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="null") }
          Block {
            Let(name=afterNull) { Add { Var(name=start) Lit(value=4) } }
            If {
              Call(target=allWsFrom) { Var(name=text) Var(name=afterNull) Var(name=len) }
              Block { Return { Call(target=resultOkString) { Lit(value="null") } } }
              Block { Lit(value=0) }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="true") }
          Block {
            Let(name=afterTrue) { Add { Var(name=start) Lit(value=4) } }
            If {
              Call(target=allWsFrom) { Var(name=text) Var(name=afterTrue) Var(name=len) }
              Block { Return { Call(target=resultOkString) { Lit(value="true") } } }
              Block { Lit(value=0) }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Call(target=startsWithAt) { Var(name=text) Var(name=start) Lit(value="false") }
          Block {
            Let(name=afterFalse) { Add { Var(name=start) Lit(value=5) } }
            If {
              Call(target=allWsFrom) { Var(name=text) Var(name=afterFalse) Var(name=len) }
              Block { Return { Call(target=resultOkString) { Lit(value="false") } } }
              Block { Lit(value=0) }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Eq { Var(name=startCh) Lit(value="\"") }
          Block {
            Let(name=closeIndex) {
              Call(target=findStringClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=closeIndex) Lit(value=-1) }
              Block {
                Return {
                  Call(target=resultErr) {
                    Lit(value="JSON_UNTERMINATED_STRING")
                    Lit(value="String literal is not terminated.")
                  }
                }
              }
              Block {
                Let(name=afterString) { Add { Var(name=closeIndex) Lit(value=1) } }
                If {
                  Call(target=allWsFrom) { Var(name=text) Var(name=afterString) Var(name=len) }
                  Block {
                    Return {
                      Call(target=resultOkString) {
                        Call(target=collectTokenRange) {
                          Var(name=text)
                          Var(name=start)
                          Var(name=afterString)
                          Lit(value="")
                        }
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Eq { Var(name=startCh) Lit(value="{") }
          Block {
            Let(name=objectClose) {
              Call(target=findCompositeClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value="{")
                Lit(value="}")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=objectClose) Lit(value=-1) }
              Block {
                Return {
                  Call(target=resultErr) {
                    Lit(value="JSON_UNTERMINATED_OBJECT")
                    Lit(value="Object literal is not terminated.")
                  }
                }
              }
              Block {
                Let(name=afterObject) { Add { Var(name=objectClose) Lit(value=1) } }
                If {
                  Call(target=allWsFrom) { Var(name=text) Var(name=afterObject) Var(name=len) }
                  Block {
                    Return {
                      Call(target=resultOkString) {
                        Call(target=collectTokenRange) {
                          Var(name=text)
                          Var(name=start)
                          Var(name=afterObject)
                          Lit(value="")
                        }
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }

        If {
          Eq { Var(name=startCh) Lit(value="[") }
          Block {
            Let(name=arrayClose) {
              Call(target=findCompositeClose) {
                Var(name=text)
                Add { Var(name=start) Lit(value=1) }
                Var(name=len)
                Lit(value="[")
                Lit(value="]")
                Lit(value=1)
                Lit(value=false)
                Lit(value=false)
              }
            }
            If {
              Eq { Var(name=arrayClose) Lit(value=-1) }
              Block {
                Return {
                  Call(target=resultErr) {
                    Lit(value="JSON_UNTERMINATED_ARRAY")
                    Lit(value="Array literal is not terminated.")
                  }
                }
              }
              Block {
                Let(name=afterArray) { Add { Var(name=arrayClose) Lit(value=1) } }
                If {
                  Call(target=allWsFrom) { Var(name=text) Var(name=afterArray) Var(name=len) }
                  Block {
                    Return {
                      Call(target=resultOkString) {
                        Call(target=collectTokenRange) {
                          Var(name=text)
                          Var(name=start)
                          Var(name=afterArray)
                          Lit(value="")
                        }
                      }
                    }
                  }
                  Block { Lit(value=0) }
                }
              }
            }
          }
          Block { Lit(value=0) }
        }

        Let(name=numberToken) { Call(target=scanNumberToken) { Var(name=text) Var(name=start) Var(name=len) Lit(value="") } }
        If {
          Eq { Var(name=numberToken) Lit(value="") }
          Block { Lit(value=0) }
          Block {
            Let(name=numberLen) { Call(target=textLength) { Var(name=numberToken) } }
            Let(name=afterNumber) { Add { Var(name=start) Var(name=numberLen) } }
            If {
              Call(target=containsDigitAt) { Var(name=numberToken) Lit(value=0) Var(name=numberLen) }
              Block {
                If {
                  Call(target=allWsFrom) { Var(name=text) Var(name=afterNumber) Var(name=len) }
                  Block { Return { Call(target=resultOkString) { Var(name=numberToken) } } }
                  Block { Lit(value=0) }
                }
              }
              Block { Lit(value=0) }
            }
          }
        }

        Return {
          Call(target=resultErr) {
            Lit(value="JSON_UNSUPPORTED")
            Lit(value="Parser supports null, booleans, numbers, quoted strings, arrays, and objects.")
          }
        }
      }
    }
  }

  Export(name=encode)
  Export(name=parse)
  Export(name=parseNode)
}
