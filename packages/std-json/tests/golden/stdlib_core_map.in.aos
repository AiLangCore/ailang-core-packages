Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(package="std-json" path="src/format/json.aos")

  Let(name=state) {
    Map {
      Field(key="name") { Lit(value="Ada") }
      Field(key="count") { Lit(value=3) }
      Field(key="ready") { Lit(value=true) }
      Field(key="meta") {
        Map {
          Field(key="city") { Lit(value="Austin") }
        }
      }
    }
  }

  Let(name=state2) {
    Call(target=mapSet) {
      Var(name=state)
      Lit(value="count")
      Lit(value=4)
    }
  }

  Let(name=state3) {
    Call(target=mapSet) {
      Var(name=state2)
      Lit(value="mode")
      Lit(value="live")
    }
  }

  Let(name=state4) {
    Call(target=mapSet) {
      Var(name=state3)
      Lit(value="ready")
      Lit(value=false)
    }
  }

  Call(target=io.print) {
    Call(target=mapHas) {
      Var(name=state4)
      Lit(value="name")
    }
  }

  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=state4)
      Lit(value="name")
      Lit(value="")
    }
  }

  Call(target=io.print) {
    Call(target=mapGetIntOr) {
      Var(name=state4)
      Lit(value="count")
      Lit(value=0)
    }
  }

  Call(target=io.print) {
    Call(target=mapGetBoolOr) {
      Var(name=state4)
      Lit(value="ready")
      Lit(value=true)
    }
  }

  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=state4)
      Lit(value="mode")
      Lit(value="")
    }
  }

  Call(target=io.print) {
    Call(target=std.json.stringify) {
      Call(target=mapGetNodeOr) {
        Var(name=state4)
        Lit(value="meta")
        Map { }
      }
    }
  }

  Call(target=io.print) {
    ToString {
      ChildCount {
        Call(target=mapGetNodeOr) {
          Var(name=state4)
          Lit(value="meta")
          Map { }
        }
      }
    }
  }

  Call(target=io.print) {
    Call(target=mapGetStringOr) {
      Var(name=state4)
      Lit(value="count")
      Lit(value="fallback")
    }
  }

  Call(target=io.print) {
    ToString {
      Call(target=mapGetIntOr) {
        Var(name=state4)
        Lit(value="name")
        Lit(value=99)
      }
    }
  }

  Call(target=io.print) {
    ToString {
      Call(target=mapGetBoolOr) {
        Var(name=state4)
        Lit(value="mode")
        Lit(value=true)
      }
    }
  }
}
