Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(package="std-json" path="src/format/json.aos")
  Call(target=ChildCount) {
    Call(target=resultNodeOr) {
      Call(target=parseNode) { Lit(value="[1,true,{\"a\":2}]") }
      Call(target=nodeEmpty) { Lit(value="fallback") }
    }
  }
}
