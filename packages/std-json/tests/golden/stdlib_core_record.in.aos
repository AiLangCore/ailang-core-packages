Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(package="std-json" path="src/format/json.aos")

  Let(name=state) {
    Call(target=recordSet) {
      Call(target=recordSet) {
        Call(target=recordSet) {
          Call(target=recordEmpty) {
            Lit(value="State")
          }
          Lit(value="name")
          Lit(value="Ada")
        }
        Lit(value="count")
        Lit(value=7)
      }
      Lit(value="ready")
      Lit(value=true)
    }
  }

  Call(target=io.print) {
    Call(target=recordHas) {
      Var(name=state)
      Lit(value="name")
    }
  }

  Call(target=io.print) {
    Call(target=recordGetStringOr) {
      Var(name=state)
      Lit(value="name")
      Lit(value="")
    }
  }

  Call(target=io.print) {
    ToString {
      Call(target=recordGetIntOr) {
        Var(name=state)
        Lit(value="count")
        Lit(value=0)
      }
    }
  }

  Call(target=io.print) {
    ToString {
      Call(target=recordGetBoolOr) {
        Var(name=state)
        Lit(value="ready")
        Lit(value=false)
      }
    }
  }

  Call(target=io.print) {
    Call(target=std.json.stringify) {
      Call(target=recordGetNodeOr) {
        Var(name=state)
        Lit(value="missing")
        Call(target=recordEmpty) {
          Lit(value="Fallback")
        }
      }
    }
  }
}
