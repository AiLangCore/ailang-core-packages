Program {
  Let(name=udpBind) {
    Fn(params=host,port) {
      Block {
        Return {
          Call(target=sys.net.udp.bind) {
            Var(name=host)
            Var(name=port)
          }
        }
      }
    }
  }

  Let(name=udpSend) {
    Fn(params=handle,host,port,data) {
      Block {
        Return {
          Call(target=sys.net.udp.send) {
            Var(name=handle)
            Var(name=host)
            Var(name=port)
            Var(name=data)
          }
        }
      }
    }
  }

  Let(name=udpRecv) {
    Fn(params=handle,maxBytes) {
      Block {
        Return {
          Call(target=sys.net.udp.recv) {
            Var(name=handle)
            Var(name=maxBytes)
          }
        }
      }
    }
  }

  Export(name=udpBind)
  Export(name=udpSend)
  Export(name=udpRecv)
}
