Program {
  Import(sdk="ailang" path="std/str.aos")
  Import(path="common.aos")
  Import(path="scanner.aos")

  Export(name=generateCommandRegistry)
  Export(name=generateImports)
  Export(name=generateRegistryFunction)
  Export(name=generateHelpFunction)
  Export(name=generateDispatchFunction)

  // Main entry point: generate complete commands.g.aos file
  Let(name=generateCommandRegistry) {
    Fn(params=cliPath) {
      Block {
        Let(name=commands) { Call(target=scanCommandDirectories) { Var(name=cliPath) } }

        Let(name=imports) { Call(target=generateImports) { Var(name=commands) } }
        Let(name=registry) { Call(target=generateRegistryFunction) { Var(name=commands) } }
        Let(name=help) { Call(target=generateHelpFunction) { Var(name=commands) } }
        Let(name=dispatcher) { Call(target=generateDispatchFunction) { Var(name=commands) } }

        Let(name=header) {
          Lit(value="// Generated command registry\n// DO NOT EDIT - This file is auto-generated from command directories\n\nProgram {\n  Import(package=\"std-cli\" namespace=\"std.cli.dispatch\")\n  Import(package=\"std-cli\" namespace=\"std.cli.args\")\n\n")
        }

        Let(name=exports) {
          Lit(value="  Export(name=getCommandFunction)\n  Export(name=commandRegistry)\n  Export(name=getCommandHelp)\n  Export(name=dispatchCommand)\n\n")
        }

        Let(name=footer) {
          Lit(value="}\n")
        }

        Return {
          StrConcat {
            Var(name=header)
            StrConcat {
              Var(name=imports)
              StrConcat {
                Var(name=exports)
                StrConcat {
                  Var(name=registry)
                  StrConcat {
                    Var(name=help)
                    StrConcat {
                      Var(name=dispatcher)
                      Var(name=footer)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Generate import statements for each command
  Let(name=generateImports) {
    Fn(params=commands) {
      Block {
        Return { Call(target=generateImportsRecursive) { Var(name=commands) Lit(value=0) Lit(value="") } }
      }
    }
  }

  Let(name=generateImportsRecursive) {
    Fn(params=commands,index,accumulated) {
      Block {
        Let(name=count) { ChildCount { Var(name=commands) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=accumulated) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=dirName) { AttrValueString { Var(name=cmd) Lit(value="directory") } }
            Let(name=commandName) { AttrValueString { Var(name=cmd) Lit(value="command") } }

            If {
              Eq { Var(name=commandName) Lit(value="") }
              Block {
                // Skip commands without metadata
                Return {
                  Call(target=generateImportsRecursive) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=accumulated)
                  }
                }
              }
              Block {
                Let(name=importLine) {
                  StrConcat {
                    Lit(value="  Import(path=\"")
                    StrConcat {
                      Var(name=dirName)
                      StrConcat {
                        Lit(value="/")
                        StrConcat {
                          Call(target=toLowerCase) { Var(name=commandName) }
                          Lit(value=".aos\")\n")
                        }
                      }
                    }
                  }
                }

                Let(name=newAccumulated) { StrConcat { Var(name=accumulated) Var(name=importLine) } }

                Return {
                  Call(target=generateImportsRecursive) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=newAccumulated)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Generate getCommandFunction that returns command handler
  Let(name=generateRegistryFunction) {
    Fn(params=commands) {
      Block {
        Let(name=header) {
          Lit(value="  Let(name=getCommandFunction) {\n    Fn(params=cmd) {\n      Block {\n")
        }

        Let(name=body) { Call(target=generateRegistryBody) { Var(name=commands) Lit(value=0) } }

        Let(name=footer) {
          Lit(value="      }\n    }\n  }\n\n  Let(name=commandRegistry) {\n    Fn(params=_) {\n      Block {\n        Return { List {")
        }

        Let(name=cmdList) { Call(target=generateCommandList) { Var(name=commands) Lit(value=0) Lit(value="") } }

        Let(name=listFooter) {
          Lit(value=" } }\n      }\n    }\n  }\n\n")
        }

        Return {
          StrConcat {
            Var(name=header)
            StrConcat {
              Var(name=body)
              StrConcat {
                Var(name=footer)
                StrConcat {
                  Var(name=cmdList)
                  Var(name=listFooter)
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=generateRegistryBody) {
    Fn(params=commands,index) {
      Block {
        Let(name=count) { ChildCount { Var(name=commands) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block {
            Return {
              Lit(value="        Return { Lit(value=0) }\n")
            }
          }
          Block {
            Let(name=cmd) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=commandName) { AttrValueString { Var(name=cmd) Lit(value="command") } }

            If {
              Eq { Var(name=commandName) Lit(value="") }
              Block {
                Return { Call(target=generateRegistryBody) { Var(name=commands) Add { Var(name=index) Lit(value=1) } } }
              }
              Block {
                Let(name=functionName) {
                  StrConcat {
                    Lit(value="run")
                    Call(target=capitalize) { Var(name=commandName) }
                  }
                }

                Let(name=ifBlock) {
                  StrConcat {
                    Lit(value="        If {\n          Eq { Var(name=cmd) Lit(value=\"")
                    StrConcat {
                      Var(name=commandName)
                      StrConcat {
                        Lit(value="\") }\n          Block { Return { Var(name=")
                        StrConcat {
                          Var(name=functionName)
                          Lit(value=") } }\n          Block {\n")
                        }
                      }
                    }
                  }
                }

                Let(name=rest) { Call(target=generateRegistryBody) { Var(name=commands) Add { Var(name=index) Lit(value=1) } } }

                Return {
                  StrConcat {
                    Var(name=ifBlock)
                    StrConcat {
                      Var(name=rest)
                      Lit(value="          }\n        }\n")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=generateCommandList) {
    Fn(params=commands,index,accumulated) {
      Block {
        Let(name=count) { ChildCount { Var(name=commands) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=accumulated) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=commandName) { AttrValueString { Var(name=cmd) Lit(value="command") } }

            If {
              Eq { Var(name=commandName) Lit(value="") }
              Block {
                Return {
                  Call(target=generateCommandList) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=accumulated)
                  }
                }
              }
              Block {
                Let(name=entry) {
                  StrConcat {
                    Lit(value=" Lit(value=\"")
                    StrConcat { Var(name=commandName) Lit(value="\")") }
                  }
                }

                Let(name=newAccumulated) { StrConcat { Var(name=accumulated) Var(name=entry) } }

                Return {
                  Call(target=generateCommandList) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=newAccumulated)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Generate help function using command metadata
  Let(name=generateHelpFunction) {
    Fn(params=commands) {
      Block {
        Let(name=header) {
          Lit(value="  Let(name=getCommandHelp) {\n    Fn(params=appInfo,options) {\n      Block {\n")
        }

        Let(name=commandsData) { Call(target=generateCommandsData) { Var(name=commands) } }

        Let(name=body) {
          StrConcat {
            Lit(value="        Let(name=commands) {\n          List {\n")
            StrConcat {
              Var(name=commandsData)
              Lit(value="          }\n        }\n\n        Return { Call(target=formatHelp) { Var(name=appInfo) Var(name=commands) Var(name=options) } }\n")
            }
          }
        }

        Let(name=footer) {
          Lit(value="      }\n    }\n  }\n")
        }

        Return {
          StrConcat {
            Var(name=header)
            StrConcat { Var(name=body) Var(name=footer) }
          }
        }
      }
    }
  }

  // Generate command metadata as AoS code
  Let(name=generateCommandsData) {
    Fn(params=commands) {
      Block {
        Return { Call(target=generateCommandsDataRecursive) { Var(name=commands) Lit(value=0) Lit(value="") } }
      }
    }
  }

  Let(name=generateCommandsDataRecursive) {
    Fn(params=commands,index,accumulated) {
      Block {
        Let(name=count) { ChildCount { Var(name=commands) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=accumulated) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=commandName) { AttrValueString { Var(name=cmd) Lit(value="command") } }
            Let(name=summary) { AttrValueString { Var(name=cmd) Lit(value="summary") } }

            If {
              Eq { Var(name=commandName) Lit(value="") }
              Block {
                // Skip commands without metadata
                Return {
                  Call(target=generateCommandsDataRecursive) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=accumulated)
                  }
                }
              }
              Block {
                Let(name=mapEntry) {
                  StrConcat {
                    Lit(value="            Map {\n              Entry { Lit(value=\"command\") Lit(value=\"")
                    StrConcat {
                      Var(name=commandName)
                      StrConcat {
                        Lit(value="\") }\n              Entry { Lit(value=\"summary\") Lit(value=\"")
                        StrConcat {
                          Var(name=summary)
                          Lit(value="\") }\n            }\n")
                        }
                      }
                    }
                  }
                }

                Let(name=newAccumulated) { StrConcat { Var(name=accumulated) Var(name=mapEntry) } }

                Return {
                  Call(target=generateCommandsDataRecursive) {
                    Var(name=commands)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=newAccumulated)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Helper: convert string to lowercase
  Let(name=toLowerCase) {
    Fn(params=str) {
      Block {
        // Simplified: just return as-is for now
        // Real implementation would convert to lowercase
        Return { Var(name=str) }
      }
    }
  }

  // Helper: capitalize first letter
  Let(name=capitalize) {
    Fn(params=str) {
      Block {
        Let(name=len) { Call(target=length) { Var(name=str) } }

        If {
          Eq { Var(name=len) Lit(value=0) }
          Block { Return { Lit(value="") } }
          Block {
            Let(name=first) { Call(target=substring) { Var(name=str) Lit(value=0) Lit(value=1) } }
            Let(name=rest) { Call(target=substring) { Var(name=str) Lit(value=1) Var(name=len) } }
            Return { StrConcat { Call(target=toUpperCase) { Var(name=first) } Var(name=rest) } }
          }
        }
      }
    }
  }

  // Helper: convert to uppercase (simplified)
  Let(name=toUpperCase) {
    Fn(params=str) {
      Block {
        // Simplified: handle common cases
        If { Eq { Var(name=str) Lit(value="c") } Block { Return { Lit(value="C") } } Block {
        If { Eq { Var(name=str) Lit(value="i") } Block { Return { Lit(value="I") } } Block {
        If { Eq { Var(name=str) Lit(value="b") } Block { Return { Lit(value="B") } } Block {
        If { Eq { Var(name=str) Lit(value="r") } Block { Return { Lit(value="R") } } Block {
        If { Eq { Var(name=str) Lit(value="p") } Block { Return { Lit(value="P") } } Block {
        If { Eq { Var(name=str) Lit(value="t") } Block { Return { Lit(value="T") } } Block {
        If { Eq { Var(name=str) Lit(value="a") } Block { Return { Lit(value="A") } } Block {
          Return { Var(name=str) }
        }}}}}}}}}}}}}}}
      }
    }
  }

  // Generate dispatch function that automatically handles help, version, and command execution
  Let(name=generateDispatchFunction) {
    Fn(params=commands) {
      Block {
        Return {
          Lit(value="  Let(name=dispatchCommand) {\n    Fn(params=appInfo,options,args) {\n      Block {\n        Return { Call(target=dispatch) { Var(name=appInfo) Call(target=commandRegistry) { Lit(value=0) } Var(name=options) Var(name=getCommandFunction) Var(name=args) } }\n      }\n    }\n  }\n")
        }
      }
    }
  }
}
