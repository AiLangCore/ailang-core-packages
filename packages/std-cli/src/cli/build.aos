Program {
  Import(sdk="ailang" path="std/str.aos")
  Import(path="scanner.aos")
  Import(path="common.aos")

  Export(name=buildSubcommands)
  Export(name=buildSubcommand)
  Export(name=getSubcommandOutputPath)
  Export(name=buildMainExecutable)

  // Build all subcommands into separate .aibc1 files
  // cliPath: Path to CLI source directory (e.g., "src/cli")
  // outputDir: Output directory for compiled commands (e.g., "build/lib/command")
  // Returns: Map with success status and list of built commands
  Let(name=buildSubcommands) {
    Fn(params=cliPath,outputDir) {
      Block {
        // Scan for command directories
        Let(name=commands) { Call(target=scanCommandDirectories) { Var(name=cliPath) } }

        // Ensure output directory exists
        Call(target=sys.fs.dir.create) { Var(name=outputDir) }

        // Build each command
        Let(name=results) { Call(target=buildCommandsRecursive) { Var(name=commands) Var(name=cliPath) Var(name=outputDir) Lit(value=0) List {} } }

        Return {
          Map {
            Entry { Lit(value="success") Lit(value=true) }
            Entry { Lit(value="commands") Var(name=results) }
          }
        }
      }
    }
  }

  Let(name=buildCommandsRecursive) {
    Fn(params=commands,cliPath,outputDir,index,results) {
      Block {
        Let(name=count) { ChildCount { Var(name=commands) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=results) } }
          Block {
            Let(name=cmd) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=commandName) { AttrValueString { Var(name=cmd) Lit(value="command") } }
            Let(name=directory) { AttrValueString { Var(name=cmd) Lit(value="directory") } }

            If {
              Eq { Var(name=commandName) Lit(value="") }
              Block {
                // Skip commands without metadata
                Return {
                  Call(target=buildCommandsRecursive) {
                    Var(name=commands)
                    Var(name=cliPath)
                    Var(name=outputDir)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=results)
                  }
                }
              }
              Block {
                // Build this command
                Let(name=sourcePath) {
                  StrConcat {
                    Var(name=cliPath)
                    StrConcat {
                      Lit(value="/")
                      StrConcat {
                        Var(name=directory)
                        StrConcat {
                          Lit(value="/")
                          StrConcat {
                            Call(target=toLowerCase) { Var(name=commandName) }
                            Lit(value=".aos")
                          }
                        }
                      }
                    }
                  }
                }

                Let(name=outputPath) {
                  StrConcat {
                    Var(name=outputDir)
                    StrConcat {
                      Lit(value="/")
                      StrConcat {
                        Call(target=toLowerCase) { Var(name=commandName) }
                        Lit(value=".aibc1")
                      }
                    }
                  }
                }

                // Compile command to .aibc1
                Let(name=buildResult) { Call(target=buildSubcommand) { Var(name=sourcePath) Var(name=outputPath) } }

                // Add to results
                Let(name=newResults) {
                  Call(target=listAppend) {
                    Var(name=results)
                    Map {
                      Entry { Lit(value="command") Var(name=commandName) }
                      Entry { Lit(value="source") Var(name=sourcePath) }
                      Entry { Lit(value="output") Var(name=outputPath) }
                      Entry { Lit(value="success") Var(name=buildResult) }
                    }
                  }
                }

                Return {
                  Call(target=buildCommandsRecursive) {
                    Var(name=commands)
                    Var(name=cliPath)
                    Var(name=outputDir)
                    Add { Var(name=index) Lit(value=1) }
                    Var(name=newResults)
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Build a single subcommand
  // sourcePath: Path to command source file (e.g., "src/cli/Build/build.aos")
  // outputPath: Path to output .aibc1 file (e.g., "build/lib/command/build.aibc1")
  // Returns: true on success, false on failure
  Let(name=buildSubcommand) {
    Fn(params=sourcePath,outputPath) {
      Block {
        // Check if source exists
        If {
          Not { Call(target=sys.fs.path.exists) { Var(name=sourcePath) } }
          Block {
            Call(target=sys.stdout.writeLine) {
              StrConcat {
                Lit(value="Error: Source file not found: ")
                Var(name=sourcePath)
              }
            }
            Return { Lit(value=false) }
          }
          Block { Lit(value=0) }
        }

        // Compile source to bytecode
        // This would call the AiLang compiler
        // For now, placeholder that shows the intent
        Let(name=compileCmd) {
          StrConcat {
            Lit(value="ailang compile ")
            StrConcat {
              Var(name=sourcePath)
              StrConcat {
                Lit(value=" -o ")
                Var(name=outputPath)
              }
            }
          }
        }

        Call(target=sys.stdout.writeLine) {
          StrConcat {
            Lit(value="Building: ")
            StrConcat {
              Var(name=sourcePath)
              StrConcat {
                Lit(value=" -> ")
                Var(name=outputPath)
              }
            }
          }
        }

        // TODO: Actually invoke compiler
        // Let(name=exitCode) { Call(target=sys.process.run) { Var(name=compileCmd) } }
        // Return { Eq { Var(name=exitCode) Lit(value=0) } }

        // Placeholder success
        Return { Lit(value=true) }
      }
    }
  }

  // Get output path for a subcommand
  Let(name=getSubcommandOutputPath) {
    Fn(params=outputDir,commandName) {
      Block {
        Return {
          StrConcat {
            Var(name=outputDir)
            StrConcat {
              Lit(value="/")
              StrConcat {
                Call(target=toLowerCase) { Var(name=commandName) }
                Lit(value=".aibc1")
              }
            }
          }
        }
      }
    }
  }

  // Build main executable (ailang.aibc1) with dynamic subcommand loading
  // mainSourcePath: Path to main app.aos
  // outputPath: Path to output ailang.aibc1
  // commandDir: Directory where command .aibc1 files are located (e.g., "lib/command")
  Let(name=buildMainExecutable) {
    Fn(params=mainSourcePath,outputPath,commandDir) {
      Block {
        Call(target=sys.stdout.writeLine) {
          StrConcat {
            Lit(value="Building main executable: ")
            StrConcat {
              Var(name=mainSourcePath)
              StrConcat {
                Lit(value=" -> ")
                Var(name=outputPath)
              }
            }
          }
        }

        // Compile main with command directory reference
        Let(name=compileCmd) {
          StrConcat {
            Lit(value="ailang compile ")
            StrConcat {
              Var(name=mainSourcePath)
              StrConcat {
                Lit(value=" -o ")
                StrConcat {
                  Var(name=outputPath)
                  StrConcat {
                    Lit(value=" --command-dir=")
                    Var(name=commandDir)
                  }
                }
              }
            }
          }
        }

        // TODO: Actually invoke compiler
        // Let(name=exitCode) { Call(target=sys.process.run) { Var(name=compileCmd) } }
        // Return { Eq { Var(name=exitCode) Lit(value=0) } }

        Return { Lit(value=true) }
      }
    }
  }

  // Helper: convert to lowercase (simplified)
  Let(name=toLowerCase) {
    Fn(params=str) {
      Block {
        // Simplified - just return as-is
        Return { Var(name=str) }
      }
    }
  }

  // Helper: append to list
  Let(name=listAppend) {
    Fn(params=list,item) {
      Block {
        // Placeholder
        Return { Var(name=list) }
      }
    }
  }
}
