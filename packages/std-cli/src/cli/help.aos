Program {
  Import(sdk="ailang" path="std/core.aos")

  Export(name=formatRootHelp)
  Export(name=formatCommandHelp)
  Export(name=formatVersion)

  Let(name=formatRootHelp) {
    Fn(params=application) {
      Block {
        Let(name=name) { Call(target=mapGetStringOr) { Var(name=application) Lit(value="name") Lit(value="") } }
        Let(name=summary) { Call(target=mapGetStringOr) { Var(name=application) Lit(value="summary") Lit(value="") } }
        Let(name=commands) { Call(target=mapGetNodeOr) { Var(name=application) Lit(value="commands") MakeBlock { Lit(value="List") } } }
        Let(name=header) { StrConcat { Lit(value="Usage: ") StrConcat { Var(name=name) Lit(value=" <command> [options]\n\n") } } }
        Let(name=withSummary) { StrConcat { Var(name=header) StrConcat { Var(name=summary) Lit(value="\n\nCommands:\n") } } }
        Let(name=body) { Call(target=formatCommands) { Var(name=commands) Lit(value=0) Lit(value="") } }
        Return { StrConcat { Var(name=withSummary) Var(name=body) } }
      }
    }
  }

  Let(name=formatCommands) {
    Fn(params=commands,index,output) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=commands) } }
          Block {
            Return {
              StrConcat {
                Var(name=output)
                Lit(value="  help  Show help\n  version  Show version")
              }
            }
          }
          Block {
            Let(name=command) { ChildAt { Var(name=commands) Var(name=index) } }
            Let(name=line) {
              StrConcat {
                Lit(value="  ")
                StrConcat {
                  Call(target=mapGetStringOr) { Var(name=command) Lit(value="name") Lit(value="") }
                  StrConcat {
                    Lit(value="  ")
                    StrConcat {
                      Call(target=mapGetStringOr) { Var(name=command) Lit(value="summary") Lit(value="") }
                      Lit(value="\n")
                    }
                  }
                }
              }
            }
            Return { Call(target=formatCommands) { Var(name=commands) Add { Var(name=index) Lit(value=1) } StrConcat { Var(name=output) Var(name=line) } } }
          }
        }
      }
    }
  }

  Let(name=formatCommandHelp) {
    Fn(params=application,command) {
      Block {
        Let(name=appName) { Call(target=mapGetStringOr) { Var(name=application) Lit(value="name") Lit(value="") } }
        Let(name=commandName) { Call(target=mapGetStringOr) { Var(name=command) Lit(value="name") Lit(value="") } }
        Let(name=usage) { Call(target=mapGetStringOr) { Var(name=command) Lit(value="usage") Lit(value="") } }
        Let(name=usageText) {
          If {
            Eq { Var(name=usage) Lit(value="") }
            Block { StrConcat { Var(name=appName) StrConcat { Lit(value=" ") Var(name=commandName) } } }
            Block { StrConcat { Var(name=appName) StrConcat { Lit(value=" ") Var(name=usage) } } }
          }
        }
        Let(name=output) {
          StrConcat {
            Lit(value="Usage: ")
            StrConcat {
              Var(name=usageText)
              StrConcat {
                Lit(value="\n\n")
                StrConcat {
                  Call(target=mapGetStringOr) { Var(name=command) Lit(value="summary") Lit(value="") }
                  Lit(value="\n")
                }
              }
            }
          }
        }
        Let(name=arguments) { Call(target=mapGetNodeOr) { Var(name=command) Lit(value="arguments") MakeBlock { Lit(value="List") } } }
        Let(name=withArguments) {
          If {
            Eq { ChildCount { Var(name=arguments) } Lit(value=0) }
            Block { Var(name=output) }
            Block { StrConcat { Var(name=output) StrConcat { Lit(value="\nArguments:\n") Call(target=formatArguments) { Var(name=arguments) Lit(value=0) Lit(value="") } } } }
          }
        }
        Let(name=options) { Call(target=mapGetNodeOr) { Var(name=command) Lit(value="options") MakeBlock { Lit(value="List") } } }
        Return {
          StrConcat {
            Var(name=withArguments)
            StrConcat {
              Lit(value="\nOptions:\n")
              StrConcat {
                Call(target=formatOptions) { Var(name=options) Lit(value=0) Lit(value="") }
                Lit(value="  -h, --help  Show command help")
              }
            }
          }
        }
      }
    }
  }

  Let(name=formatArguments) {
    Fn(params=arguments,index,output) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=arguments) } }
          Block { Return { Var(name=output) } }
          Block {
            Let(name=argument) { ChildAt { Var(name=arguments) Var(name=index) } }
            Let(name=line) {
              StrConcat {
                Lit(value="  ")
                StrConcat {
                  Call(target=mapGetStringOr) { Var(name=argument) Lit(value="name") Lit(value="") }
                  StrConcat {
                    Lit(value="  ")
                    StrConcat {
                      Call(target=mapGetStringOr) { Var(name=argument) Lit(value="description") Lit(value="") }
                      Lit(value="\n")
                    }
                  }
                }
              }
            }
            Return { Call(target=formatArguments) { Var(name=arguments) Add { Var(name=index) Lit(value=1) } StrConcat { Var(name=output) Var(name=line) } } }
          }
        }
      }
    }
  }

  Let(name=formatOptions) {
    Fn(params=options,index,output) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=options) } }
          Block { Return { Var(name=output) } }
          Block {
            Let(name=option) { ChildAt { Var(name=options) Var(name=index) } }
            Let(name=name) { Call(target=mapGetStringOr) { Var(name=option) Lit(value="name") Lit(value="") } }
            Let(name=alias) { Call(target=mapGetStringOr) { Var(name=option) Lit(value="alias") Lit(value="") } }
            Let(name=signature) {
              If {
                Eq { Var(name=alias) Lit(value="") }
                Block { StrConcat { Lit(value="--") Var(name=name) } }
                Block { StrConcat { Lit(value="-") StrConcat { Var(name=alias) StrConcat { Lit(value=", --") Var(name=name) } } } }
              }
            }
            Let(name=valueSuffix) {
              If {
                Call(target=mapGetBoolOr) { Var(name=option) Lit(value="requiresValue") Lit(value=false) }
                Block { Lit(value=" <value>") }
                Block { Lit(value="") }
              }
            }
            Let(name=line) {
              StrConcat {
                Lit(value="  ")
                StrConcat {
                  Var(name=signature)
                  StrConcat {
                    Var(name=valueSuffix)
                    StrConcat {
                      Lit(value="  ")
                      StrConcat {
                        Call(target=mapGetStringOr) { Var(name=option) Lit(value="description") Lit(value="") }
                        Lit(value="\n")
                      }
                    }
                  }
                }
              }
            }
            Return { Call(target=formatOptions) { Var(name=options) Add { Var(name=index) Lit(value=1) } StrConcat { Var(name=output) Var(name=line) } } }
          }
        }
      }
    }
  }

  Let(name=formatVersion) {
    Fn(params=application) {
      Block {
        Return {
          StrConcat {
            Call(target=mapGetStringOr) { Var(name=application) Lit(value="name") Lit(value="") }
            StrConcat {
              Lit(value=" ")
              StrConcat {
                Call(target=mapGetStringOr) { Var(name=application) Lit(value="version") Lit(value="") }
                Lit(value="")
              }
            }
          }
        }
      }
    }
  }
}
