Program {
  Import(sdk="ailang" path="std/core.aos")
  Import(path="arguments.aos")
  Import(path="diagnostics.aos")
  Import(path="help.aos")
  Import(path="invoke.aos")
  Import(path="model.aos")
  Import(path="registry.aos")

  Export(name=execute)
  Export(name=run)

  Let(name=execute) {
    Fn(params=application,args) {
      Block {
        Let(name=registrationProblem) { Call(target=applicationDiagnostic) { Var(name=application) } }
        If {
          Eq { Eq { Call(target=diagnosticCode) { Var(name=registrationProblem) } Lit(value="") } Lit(value=false) }
          Block { Return { Call(target=cliResult) { Lit(value=2) Lit(value="") Var(name=registrationProblem) } } }
          Block { Lit(value=0) }
        }
        If {
          Eq { ChildCount { Var(name=args) } Lit(value=0) }
          Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatRootHelp) { Var(name=application) } Map { } } } }
          Block { Lit(value=0) }
        }
        Let(name=first) { Call(target=argText) { Var(name=args) Lit(value=0) } }
        If {
          Call(target=cliOr) { Eq { Var(name=first) Lit(value="--help") } Eq { Var(name=first) Lit(value="-h") } }
          Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatRootHelp) { Var(name=application) } Map { } } } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=cliOr) { Eq { Var(name=first) Lit(value="version") } Eq { Var(name=first) Lit(value="--version") } }
          Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatVersion) { Var(name=application) } Map { } } } }
          Block { Lit(value=0) }
        }
        If {
          Eq { Var(name=first) Lit(value="help") }
          Block { Return { Call(target=executeHelp) { Var(name=application) Var(name=args) } } }
          Block { Lit(value=0) }
        }
        Let(name=command) { Call(target=findCommand) { Var(name=application) Var(name=first) } }
        If {
          Eq { Call(target=mapGetStringOr) { Var(name=command) Lit(value="name") Lit(value="") } Lit(value="") }
          Block { Return { Call(target=cliResult) { Lit(value=2) Lit(value="") Call(target=cliDiagnostic) { Lit(value="CLI001") StrConcat { Lit(value="unknown command: ") Var(name=first) } Var(name=first) } } } }
          Block { Lit(value=0) }
        }
        If {
          Call(target=hasCommandHelp) { Var(name=args) Lit(value=1) }
          Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatCommandHelp) { Var(name=application) Var(name=command) } Map { } } } }
          Block { Lit(value=0) }
        }
        Let(name=parsed) { Call(target=parseInvocation) { Var(name=command) Var(name=args) Lit(value=1) } }
        If {
          Eq { Call(target=mapGetBoolOr) { Var(name=parsed) Lit(value="ok") Lit(value=false) } Lit(value=false) }
          Block { Return { Call(target=cliResult) { Lit(value=2) Lit(value="") Call(target=mapGetNodeOr) { Var(name=parsed) Lit(value="diagnostic") Map { } } } } }
          Block {
            Return {
              Call(target=invokeCommand) {
                Var(name=command)
                Call(target=mapGetNodeOr) {
                  Var(name=parsed)
                  Lit(value="invocation")
                  Map { }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=executeHelp) {
    Fn(params=application,args) {
      Block {
        If {
          Eq { ChildCount { Var(name=args) } Lit(value=1) }
          Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatRootHelp) { Var(name=application) } Map { } } } }
          Block {
            Let(name=topic) { Call(target=argText) { Var(name=args) Lit(value=1) } }
            Let(name=command) { Call(target=findCommand) { Var(name=application) Var(name=topic) } }
            If {
              Eq { Call(target=mapGetStringOr) { Var(name=command) Lit(value="name") Lit(value="") } Lit(value="") }
              Block { Return { Call(target=cliResult) { Lit(value=2) Lit(value="") Call(target=cliDiagnostic) { Lit(value="CLI001") StrConcat { Lit(value="unknown command: ") Var(name=topic) } Var(name=topic) } } } }
              Block { Return { Call(target=cliResult) { Lit(value=0) Call(target=formatCommandHelp) { Var(name=application) Var(name=command) } Map { } } } }
            }
          }
        }
      }
    }
  }

  Let(name=hasCommandHelp) {
    Fn(params=args,index) {
      Block {
        If {
          Eq { Var(name=index) ChildCount { Var(name=args) } }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=value) { Call(target=argText) { Var(name=args) Var(name=index) } }
            If {
              Eq { Var(name=value) Lit(value="--") }
              Block { Return { Lit(value=false) } }
              Block {
                If {
                  Call(target=cliOr) { Eq { Var(name=value) Lit(value="--help") } Eq { Var(name=value) Lit(value="-h") } }
                  Block { Return { Lit(value=true) } }
                  Block { Return { Call(target=hasCommandHelp) { Var(name=args) Add { Var(name=index) Lit(value=1) } } } }
                }
              }
            }
          }
        }
      }
    }
  }

  Let(name=argText) {
    Fn(params=args,index) {
      Block { Return { AttrValueString { ChildAt { Var(name=args) Var(name=index) } Lit(value=0) } } }
    }
  }

  Let(name=run) {
    Fn(params=application,args) {
      Block {
        Let(name=result) { Call(target=execute) { Var(name=application) Var(name=args) } }
        Let(name=output) { Call(target=mapGetStringOr) { Var(name=result) Lit(value="output") Lit(value="") } }
        If {
          Eq { Eq { Var(name=output) Lit(value="") } Lit(value=false) }
          Block { Call(target=sys.stdout.writeLine) { Var(name=output) } }
          Block { Lit(value=0) }
        }
        Let(name=diagnostic) { Call(target=mapGetNodeOr) { Var(name=result) Lit(value="diagnostic") Map { } } }
        If {
          Eq { Eq { Call(target=diagnosticCode) { Var(name=diagnostic) } Lit(value="") } Lit(value=false) }
          Block {
            Call(target=sys.stdout.writeLine) {
              StrConcat {
                Call(target=diagnosticCode) { Var(name=diagnostic) }
                StrConcat { Lit(value=": ") Call(target=diagnosticMessage) { Var(name=diagnostic) } }
              }
            }
          }
          Block { Lit(value=0) }
        }
        Return { Call(target=mapGetIntOr) { Var(name=result) Lit(value="exitCode") Lit(value=2) } }
      }
    }
  }
}
