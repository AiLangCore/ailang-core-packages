Program {
  Import(sdk="ailang" path="std/str.aos")

  Export(name=parseArgs)
  Export(name=getOption)
  Export(name=hasFlag)
  Export(name=getPositional)
  Export(name=getPositionalCount)
  Export(name=getAllPositional)
  Export(name=isHelpRequested)
  Export(name=isVersionRequested)

  // Parse command-line arguments into structured result
  // Returns map with:
  //   options: Map of option names -> values
  //   flags: Map of flag names -> true
  //   positional: List of positional arguments
  //   errors: List of error messages
  Let(name=parseArgs) {
    Fn(params=args,optionDefs) {
      Block {
        // Detect platform from first character convention
        Let(name=usePosix) { Call(target=shouldUsePosix) { Var(name=args) } }

        If {
          Var(name=usePosix)
          Block { Return { Call(target=parsePosixArgs) { Var(name=args) Var(name=optionDefs) } } }
          Block { Return { Call(target=parseDosArgs) { Var(name=args) Var(name=optionDefs) } } }
        }
      }
    }
  }

  // Detect if we should use POSIX parsing (default to POSIX unless DOS pattern detected)
  Let(name=shouldUsePosix) {
    Fn(params=args) {
      Block {
        // Check for DOS-style /option in first few arguments
        Let(name=hasDosStyle) { Call(target=detectDosStyle) { Var(name=args) Lit(value=0) Lit(value=0) } }
        Return { Not { Var(name=hasDosStyle) } }
      }
    }
  }

  Let(name=detectDosStyle) {
    Fn(params=args,index,maxCheck) {
      Block {
        Let(name=count) { ChildCount { Var(name=args) } }

        If {
          Or {
            Ge { Var(name=index) Var(name=count) }
            Ge { Var(name=maxCheck) Lit(value=3) }
          }
          Block { Return { Lit(value=false) } }
          Block {
            Let(name=arg) { Call(target=readArgAt) { Var(name=args) Var(name=index) } }
            Let(name=startsWithSlash) { Call(target=startsWith) { Var(name=arg) Lit(value="/") } }

            If {
              Var(name=startsWithSlash)
              Block { Return { Lit(value=true) } }
              Block { Return { Call(target=detectDosStyle) { Var(name=args) Add { Var(name=index) Lit(value=1) } Add { Var(name=maxCheck) Lit(value=1) } } } }
            }
          }
        }
      }
    }
  }

  // Parse POSIX/GNU style arguments
  // Supports:
  //   -v (short flag)
  //   -abc (combined short flags)
  //   -o value (short option with value)
  //   -ovalue (short option with attached value)
  //   --verbose (long flag)
  //   --output value (long option with value)
  //   --output=value (long option with = syntax)
  //   -- (end of options marker)
  Let(name=parsePosixArgs) {
    Fn(params=args,optionDefs) {
      Block {
        Let(name=result) {
          Map {
            Entry { Lit(value="options") Map {} }
            Entry { Lit(value="flags") Map {} }
            Entry { Lit(value="positional") List {} }
            Entry { Lit(value="errors") List {} }
            Entry { Lit(value="endOfOptions") Lit(value=false) }
          }
        }

        Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Lit(value=0) Var(name=result) } }
      }
    }
  }

  Let(name=parsePosixArgsRecursive) {
    Fn(params=args,optionDefs,index,result) {
      Block {
        Let(name=count) { ChildCount { Var(name=args) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=result) } }
          Block {
            Let(name=arg) { Call(target=readArgAt) { Var(name=args) Var(name=index) } }
            Let(name=endOfOptions) { Call(target=mapGetBool) { Var(name=result) Lit(value="endOfOptions") } }

            // Check for -- end of options
            If {
              Eq { Var(name=arg) Lit(value="--") }
              Block {
                Let(name=newResult) { Call(target=mapSetBool) { Var(name=result) Lit(value="endOfOptions") Lit(value=true) } }
                Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
              Block { Lit(value=0) }
            }

            // If past --, treat everything as positional
            If {
              Var(name=endOfOptions)
              Block {
                Let(name=newResult) { Call(target=addPositional) { Var(name=result) Var(name=arg) } }
                Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
              Block { Lit(value=0) }
            }

            // Check for long option --foo or --foo=bar
            Let(name=isLongOption) { Call(target=startsWith) { Var(name=arg) Lit(value="--") } }
            If {
              Var(name=isLongOption)
              Block {
                Return { Call(target=parseLongOption) { Var(name=args) Var(name=optionDefs) Var(name=index) Var(name=arg) Var(name=result) } }
              }
              Block { Lit(value=0) }
            }

            // Check for short option(s) -a or -abc or -ovalue
            Let(name=isShortOption) { Call(target=startsWith) { Var(name=arg) Lit(value="-") } }
            If {
              Var(name=isShortOption)
              Block {
                Return { Call(target=parseShortOptions) { Var(name=args) Var(name=optionDefs) Var(name=index) Var(name=arg) Var(name=result) } }
              }
              Block { Lit(value=0) }
            }

            // Otherwise it's a positional argument
            Let(name=newResult) { Call(target=addPositional) { Var(name=result) Var(name=arg) } }
            Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
          }
        }
      }
    }
  }

  // Parse long option: --verbose or --output=value or --output value
  Let(name=parseLongOption) {
    Fn(params=args,optionDefs,index,arg,result) {
      Block {
        // Strip leading --
        Let(name=withoutDashes) { Call(target=substring) { Var(name=arg) Lit(value=2) Call(target=length) { Var(name=arg) } } }

        // Check for = syntax
        Let(name=equalsPos) { Call(target=find) { Var(name=withoutDashes) Lit(value="=") Lit(value=0) } }

        If {
          Ge { Var(name=equalsPos) Lit(value=0) }
          Block {
            // --option=value syntax
            Let(name=optName) { Call(target=substring) { Var(name=withoutDashes) Lit(value=0) Var(name=equalsPos) } }
            Let(name=optValue) { Call(target=substring) { Var(name=withoutDashes) Add { Var(name=equalsPos) Lit(value=1) } Call(target=length) { Var(name=withoutDashes) } } }

            Let(name=takesValue) { Call(target=optionTakesValue) { Var(name=optionDefs) Var(name=optName) } }

            If {
              Var(name=takesValue)
              Block {
                Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=optName) Var(name=optValue) } }
                Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
              Block {
                // Flag doesn't take value, treat as error
                Let(name=newResult) { Call(target=addError) { Var(name=result) StrConcat { Lit(value="Flag --") StrConcat { Var(name=optName) Lit(value=" does not take a value") } } } }
                Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
            }
          }
          Block {
            // --option or --option value syntax
            Let(name=takesValue) { Call(target=optionTakesValue) { Var(name=optionDefs) Var(name=withoutDashes) } }

            If {
              Var(name=takesValue)
              Block {
                // Next arg is the value
                Let(name=nextIndex) { Add { Var(name=index) Lit(value=1) } }
                Let(name=hasNext) { Lt { Var(name=nextIndex) ChildCount { Var(name=args) } } }

                If {
                  Var(name=hasNext)
                  Block {
                    Let(name=optValue) { Call(target=readArgAt) { Var(name=args) Var(name=nextIndex) } }
                    Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=withoutDashes) Var(name=optValue) } }
                    Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=2) } Var(name=newResult) } }
                  }
                  Block {
                    Let(name=newResult) { Call(target=addError) { Var(name=result) StrConcat { Lit(value="Option --") StrConcat { Var(name=withoutDashes) Lit(value=" requires a value") } } } }
                    Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
                  }
                }
              }
              Block {
                // It's a flag
                Let(name=newResult) { Call(target=setFlag) { Var(name=result) Var(name=withoutDashes) } }
                Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
            }
          }
        }
      }
    }
  }

  // Parse short option(s): -v or -abc or -ovalue
  Let(name=parseShortOptions) {
    Fn(params=args,optionDefs,index,arg,result) {
      Block {
        // Strip leading -
        Let(name=withoutDash) { Call(target=substring) { Var(name=arg) Lit(value=1) Call(target=length) { Var(name=arg) } } }
        Let(name=len) { Call(target=length) { Var(name=withoutDash) } }

        If {
          Eq { Var(name=len) Lit(value=0) }
          Block {
            // Just a bare -, treat as positional
            Let(name=newResult) { Call(target=addPositional) { Var(name=result) Var(name=arg) } }
            Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
          }
          Block {
            // Process short options
            Return { Call(target=processShortOptions) { Var(name=args) Var(name=optionDefs) Var(name=index) Var(name=withoutDash) Lit(value=0) Var(name=result) } }
          }
        }
      }
    }
  }

  Let(name=processShortOptions) {
    Fn(params=args,optionDefs,argIndex,chars,charIndex,result) {
      Block {
        Let(name=len) { Call(target=length) { Var(name=chars) } }

        If {
          Ge { Var(name=charIndex) Var(name=len) }
          Block {
            // Done processing this argument
            Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=argIndex) Lit(value=1) } Var(name=result) } }
          }
          Block {
            Let(name=optChar) { Call(target=substring) { Var(name=chars) Var(name=charIndex) Add { Var(name=charIndex) Lit(value=1) } } }
            Let(name=takesValue) { Call(target=optionTakesValue) { Var(name=optionDefs) Var(name=optChar) } }

            If {
              Var(name=takesValue)
              Block {
                // Option takes a value
                Let(name=restOfChars) { Call(target=substring) { Var(name=chars) Add { Var(name=charIndex) Lit(value=1) } Var(name=len) } }

                If {
                  Gt { Call(target=length) { Var(name=restOfChars) } Lit(value=0) }
                  Block {
                    // Rest of string is the value: -ovalue
                    Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=optChar) Var(name=restOfChars) } }
                    Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=argIndex) Lit(value=1) } Var(name=newResult) } }
                  }
                  Block {
                    // Value is next argument: -o value
                    Let(name=nextIndex) { Add { Var(name=argIndex) Lit(value=1) } }
                    Let(name=hasNext) { Lt { Var(name=nextIndex) ChildCount { Var(name=args) } } }

                    If {
                      Var(name=hasNext)
                      Block {
                        Let(name=optValue) { Call(target=readArgAt) { Var(name=args) Var(name=nextIndex) } }
                        Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=optChar) Var(name=optValue) } }
                        Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=argIndex) Lit(value=2) } Var(name=newResult) } }
                      }
                      Block {
                        Let(name=newResult) { Call(target=addError) { Var(name=result) StrConcat { Lit(value="Option -") StrConcat { Var(name=optChar) Lit(value=" requires a value") } } } }
                        Return { Call(target=parsePosixArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=argIndex) Lit(value=1) } Var(name=newResult) } }
                      }
                    }
                  }
                }
              }
              Block {
                // It's a flag, continue processing more chars
                Let(name=newResult) { Call(target=setFlag) { Var(name=result) Var(name=optChar) } }
                Return { Call(target=processShortOptions) { Var(name=args) Var(name=optionDefs) Var(name=argIndex) Var(name=chars) Add { Var(name=charIndex) Lit(value=1) } Var(name=newResult) } }
              }
            }
          }
        }
      }
    }
  }

  // Parse DOS/Windows style arguments
  // Supports:
  //   /v (flag)
  //   /output:value (option with value using :)
  //   /output value (option with value using space)
  Let(name=parseDosArgs) {
    Fn(params=args,optionDefs) {
      Block {
        Let(name=result) {
          Map {
            Entry { Lit(value="options") Map {} }
            Entry { Lit(value="flags") Map {} }
            Entry { Lit(value="positional") List {} }
            Entry { Lit(value="errors") List {} }
          }
        }

        Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Lit(value=0) Var(name=result) } }
      }
    }
  }

  Let(name=parseDosArgsRecursive) {
    Fn(params=args,optionDefs,index,result) {
      Block {
        Let(name=count) { ChildCount { Var(name=args) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Var(name=result) } }
          Block {
            Let(name=arg) { Call(target=readArgAt) { Var(name=args) Var(name=index) } }
            Let(name=startsWithSlash) { Call(target=startsWith) { Var(name=arg) Lit(value="/") } }

            If {
              Var(name=startsWithSlash)
              Block {
                Return { Call(target=parseDosOption) { Var(name=args) Var(name=optionDefs) Var(name=index) Var(name=arg) Var(name=result) } }
              }
              Block {
                // Positional argument
                Let(name=newResult) { Call(target=addPositional) { Var(name=result) Var(name=arg) } }
                Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
            }
          }
        }
      }
    }
  }

  Let(name=parseDosOption) {
    Fn(params=args,optionDefs,index,arg,result) {
      Block {
        // Strip leading /
        Let(name=withoutSlash) { Call(target=substring) { Var(name=arg) Lit(value=1) Call(target=length) { Var(name=arg) } } }

        // Check for : syntax
        Let(name=colonPos) { Call(target=find) { Var(name=withoutSlash) Lit(value=":") Lit(value=0) } }

        If {
          Ge { Var(name=colonPos) Lit(value=0) }
          Block {
            // /option:value syntax
            Let(name=optName) { Call(target=substring) { Var(name=withoutSlash) Lit(value=0) Var(name=colonPos) } }
            Let(name=optValue) { Call(target=substring) { Var(name=withoutSlash) Add { Var(name=colonPos) Lit(value=1) } Call(target=length) { Var(name=withoutSlash) } } }

            Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=optName) Var(name=optValue) } }
            Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
          }
          Block {
            // /option or /option value
            Let(name=takesValue) { Call(target=optionTakesValue) { Var(name=optionDefs) Var(name=withoutSlash) } }

            If {
              Var(name=takesValue)
              Block {
                // Next arg is the value
                Let(name=nextIndex) { Add { Var(name=index) Lit(value=1) } }
                Let(name=hasNext) { Lt { Var(name=nextIndex) ChildCount { Var(name=args) } } }

                If {
                  Var(name=hasNext)
                  Block {
                    Let(name=optValue) { Call(target=readArgAt) { Var(name=args) Var(name=nextIndex) } }
                    Let(name=newResult) { Call(target=setOption) { Var(name=result) Var(name=withoutSlash) Var(name=optValue) } }
                    Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=2) } Var(name=newResult) } }
                  }
                  Block {
                    Let(name=newResult) { Call(target=addError) { Var(name=result) StrConcat { Lit(value="Option /") StrConcat { Var(name=withoutSlash) Lit(value=" requires a value") } } } }
                    Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
                  }
                }
              }
              Block {
                // It's a flag
                Let(name=newResult) { Call(target=setFlag) { Var(name=result) Var(name=withoutSlash) } }
                Return { Call(target=parseDosArgsRecursive) { Var(name=args) Var(name=optionDefs) Add { Var(name=index) Lit(value=1) } Var(name=newResult) } }
              }
            }
          }
        }
      }
    }
  }

  // Helper: Check if option takes a value based on definitions
  Let(name=optionTakesValue) {
    Fn(params=optionDefs,name) {
      Block {
        // optionDefs is a map of option names -> true (if takes value)
        // If not defined, assume it's a flag
        Let(name=isDefined) { Call(target=mapHas) { Var(name=optionDefs) Var(name=name) } }

        If {
          Var(name=isDefined)
          Block { Return { Call(target=mapGetBool) { Var(name=optionDefs) Var(name=name) } } }
          Block { Return { Lit(value=false) } }
        }
      }
    }
  }

  // Public API: Get option value from parsed result
  Let(name=getOption) {
    Fn(params=parsedArgs,name,defaultValue) {
      Block {
        Let(name=options) { Call(target=mapGetMap) { Var(name=parsedArgs) Lit(value="options") } }
        Let(name=hasOption) { Call(target=mapHas) { Var(name=options) Var(name=name) } }

        If {
          Var(name=hasOption)
          Block { Return { Call(target=mapGetString) { Var(name=options) Var(name=name) } } }
          Block { Return { Var(name=defaultValue) } }
        }
      }
    }
  }

  // Public API: Check if flag is set
  Let(name=hasFlag) {
    Fn(params=parsedArgs,name) {
      Block {
        Let(name=flags) { Call(target=mapGetMap) { Var(name=parsedArgs) Lit(value="flags") } }
        Return { Call(target=mapHas) { Var(name=flags) Var(name=name) } }
      }
    }
  }

  // Public API: Get positional argument by index
  Let(name=getPositional) {
    Fn(params=parsedArgs,index) {
      Block {
        Let(name=positional) { Call(target=mapGetList) { Var(name=parsedArgs) Lit(value="positional") } }
        Let(name=count) { ChildCount { Var(name=positional) } }

        If {
          Ge { Var(name=index) Var(name=count) }
          Block { Return { Lit(value="") } }
          Block { Return { Call(target=listGetString) { Var(name=positional) Var(name=index) } } }
        }
      }
    }
  }

  // Public API: Get count of positional arguments
  Let(name=getPositionalCount) {
    Fn(params=parsedArgs) {
      Block {
        Let(name=positional) { Call(target=mapGetList) { Var(name=parsedArgs) Lit(value="positional") } }
        Return { ChildCount { Var(name=positional) } }
      }
    }
  }

  // Public API: Get all positional arguments as list
  Let(name=getAllPositional) {
    Fn(params=parsedArgs) {
      Block {
        Return { Call(target=mapGetList) { Var(name=parsedArgs) Lit(value="positional") } }
      }
    }
  }

  // Helper functions
  Let(name=readArgAt) {
    Fn(params=args,index) {
      Block {
        Return { AttrValueString { ChildAt { Var(name=args) Var(name=index) } Lit(value=0) } }
      }
    }
  }

  Let(name=setOption) {
    Fn(params=result,name,value) {
      Block {
        Let(name=options) { Call(target=mapGetMap) { Var(name=result) Lit(value="options") } }
        Let(name=newOptions) { Call(target=mapPut) { Var(name=options) Var(name=name) Var(name=value) } }
        Return { Call(target=mapPut) { Var(name=result) Lit(value="options") Var(name=newOptions) } }
      }
    }
  }

  Let(name=setFlag) {
    Fn(params=result,name) {
      Block {
        Let(name=flags) { Call(target=mapGetMap) { Var(name=result) Lit(value="flags") } }
        Let(name=newFlags) { Call(target=mapPut) { Var(name=flags) Var(name=name) Lit(value=true) } }
        Return { Call(target=mapPut) { Var(name=result) Lit(value="flags") Var(name=newFlags) } }
      }
    }
  }

  Let(name=addPositional) {
    Fn(params=result,value) {
      Block {
        Let(name=positional) { Call(target=mapGetList) { Var(name=result) Lit(value="positional") } }
        Let(name=newPositional) { Call(target=listAppend) { Var(name=positional) Var(name=value) } }
        Return { Call(target=mapPut) { Var(name=result) Lit(value="positional") Var(name=newPositional) } }
      }
    }
  }

  Let(name=addError) {
    Fn(params=result,message) {
      Block {
        Let(name=errors) { Call(target=mapGetList) { Var(name=result) Lit(value="errors") } }
        Let(name=newErrors) { Call(target=listAppend) { Var(name=errors) Var(name=message) } }
        Return { Call(target=mapPut) { Var(name=result) Lit(value="errors") Var(name=newErrors) } }
      }
    }
  }

  // Placeholder map/list helpers (would come from std lib)
  Let(name=mapHas) {
    Fn(params=map,key) {
      Block {
        // Simplified - would check if key exists
        Return { Lit(value=false) }
      }
    }
  }

  Let(name=mapGetString) {
    Fn(params=map,key) {
      Block {
        Return { AttrValueString { Var(name=map) Var(name=key) } }
      }
    }
  }

  Let(name=mapGetBool) {
    Fn(params=map,key) {
      Block {
        Return { AttrValueBool { Var(name=map) Var(name=key) } }
      }
    }
  }

  Let(name=mapGetMap) {
    Fn(params=map,key) {
      Block {
        Return { AttrValueMap { Var(name=map) Var(name=key) } }
      }
    }
  }

  Let(name=mapGetList) {
    Fn(params=map,key) {
      Block {
        Return { AttrValueList { Var(name=map) Var(name=key) } }
      }
    }
  }

  Let(name=mapPut) {
    Fn(params=map,key,value) {
      Block {
        // Would create new map with key=value
        Return { Var(name=map) }
      }
    }
  }

  Let(name=mapSetBool) {
    Fn(params=map,key,value) {
      Block {
        // Would create new map with key=value (bool)
        Return { Var(name=map) }
      }
    }
  }

  Let(name=listAppend) {
    Fn(params=list,value) {
      Block {
        // Would create new list with value appended
        Return { Var(name=list) }
      }
    }
  }

  Let(name=listGetString) {
    Fn(params=list,index) {
      Block {
        Return { AttrValueString { ChildAt { Var(name=list) Var(name=index) } Lit(value=0) } }
      }
    }
  }

  Let(name=startsWith) {
    Fn(params=str,prefix) {
      Block {
        Let(name=prefixLen) { Call(target=length) { Var(name=prefix) } }
        Let(name=strStart) { Call(target=substring) { Var(name=str) Lit(value=0) Var(name=prefixLen) } }
        Return { Eq { Var(name=strStart) Var(name=prefix) } }
      }
    }
  }

  // Check if help was requested
  // Supports: --help, -h, /? (DOS/Windows), /help
  Let(name=isHelpRequested) {
    Fn(params=parsedArgs) {
      Block {
        Let(name=longHelp) { Call(target=hasFlag) { Var(name=parsedArgs) Lit(value="help") } }
        Let(name=shortHelp) { Call(target=hasFlag) { Var(name=parsedArgs) Lit(value="h") } }
        Let(name=dosHelp) { Call(target=hasFlag) { Var(name=parsedArgs) Lit(value="?") } }

        Return {
          Or {
            Var(name=longHelp)
            Or { Var(name=shortHelp) Var(name=dosHelp) }
          }
        }
      }
    }
  }

  // Check if version was requested
  // Supports: --version, -v (but avoid conflict with verbose), /version
  Let(name=isVersionRequested) {
    Fn(params=parsedArgs) {
      Block {
        Let(name=longVersion) { Call(target=hasFlag) { Var(name=parsedArgs) Lit(value="version") } }
        Let(name=capitalVersion) { Call(target=hasFlag) { Var(name=parsedArgs) Lit(value="V") } }

        Return { Or { Var(name=longVersion) Var(name=capitalVersion) } }
      }
    }
  }
}
